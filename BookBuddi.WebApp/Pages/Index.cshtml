@page
@model IndexModel
@{
    ViewData["Title"] = "BookBuddi Catalog";
}

@{
    var userRole = HttpContext.Session.GetString("UserRole");
    var memberName = HttpContext.Session.GetString("MemberName");
    var adminName = HttpContext.Session.GetString("AdminName");
}

<style>
    .hero-section {
        background: linear-gradient(to bottom, #f8f9fa 0%, #f8f9fa 60%, #FBDB93 60%, #FBDB93 100%);
        min-height: 500px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
        margin: -20px -12px 0;
        padding: 60px 20px;
    }

    .welcome-text {
        font-size: 8rem;
        font-weight: 300;
        letter-spacing: -2px;
        margin-bottom: 10px;
        color: #2c2c2c;
    }

    .welcome-subtext {
        font-size: 2.5rem;
        color: #8b3a3a;
        font-weight: 400;
        margin-bottom: 60px;
    }

    .search-container {
        display: flex;
        gap: 15px;
        max-width: 900px;
        width: 100%;
        align-items: center;
    }

    .search-input {
        flex: 1;
        padding: 15px 20px;
        border: 1px solid #ddd;
        border-radius: 25px;
        font-size: 1rem;
        background: white;
    }

    .search-input:focus {
        outline: none;
        border-color: #8b3a3a;
        box-shadow: 0 0 0 3px rgba(139, 58, 58, 0.1);
    }

    .book-logo {
        position: absolute;
        bottom: 20px;
        right: 60px;
        width: 180px;
        height: 180px;
        opacity: 0.8;
    }

    .auth-buttons {
        position: absolute;
        top: 20px;
        right: 30px;
        display: flex;
        gap: 15px;
    }

    .btn-signup {
        background-color: #FBDB93;
        color: #2c2c2c;
        padding: 10px 25px;
        border-radius: 20px;
        border: none;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
    }

    .btn-login {
        background-color: transparent;
        color: #2c2c2c;
        padding: 10px 25px;
        border-radius: 20px;
        border: none;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
    }

    .btn-signup:hover, .btn-login:hover {
        opacity: 0.8;
        color: #2c2c2c;
    }

    @@media (max-width: 768px) {
        .welcome-text {
            font-size: 4rem;
        }
        .welcome-subtext {
            font-size: 1.5rem;
        }
        .search-container {
            flex-direction: column;
        }
        .book-logo {
            width: 120px;
            height: 120px;
            right: 20px;
        }
    }
</style>

<div class="hero-section">
    <div class="auth-buttons">
        @if (string.IsNullOrEmpty(userRole))
        {
            <a href="/Account/Register" class="btn-signup">sign up</a>
            <a href="/Account/Login" class="btn-login">log in</a>
        }
        else if (userRole == "Admin")
        {
            <span style="margin-right: 10px;">Admin - @adminName</span>
            <a href="/Account/Logout" class="btn-login">Logout</a>
        }
        else
        {
            <span style="margin-right: 10px;">@memberName</span>
            <a href="/Account/Logout" class="btn-login">Logout</a>
        }
    </div>

    <h1 class="welcome-text">Welcome!</h1>
    <p class="welcome-subtext">to bookbuddi</p>

    <form id="searchForm" method="get" class="search-container">
        <input type="text" id="searchInput" name="searchTerm" class="search-input" placeholder="Search for books, authors, or subjects..." value="@Model.SearchTerm" />
        <button type="submit" class="btn-signup" style="padding: 15px 35px; cursor: pointer; border-radius: 25px;">Search</button>
    </form>

    <div class="book-logo">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <rect x="40" y="30" width="60" height="140" fill="#8b3a3a" rx="5"/>
            <rect x="60" y="30" width="40" height="140" fill="#a85252" rx="3"/>
            <rect x="100" y="40" width="60" height="130" fill="#d4a373" rx="5"/>
            <rect x="120" y="40" width="40" height="130" fill="#e6b88a" rx="3"/>
        </svg>
    </div>
</div>

<!-- Search Results Section -->
@if (Model.SearchResults != null && Model.SearchResults.Any())
{
    <div class="search-results-section">
        <div class="search-results-header">
            <h2>Search Results</h2>
            <p>Found @Model.SearchResults.Count book(s) for "@Model.SearchTerm"</p>
        </div>
        <div class="books-grid">
            @foreach (var book in Model.SearchResults)
            {
                <div class="book-card" onclick="showBookModal(@book.BookId)">
                    <div class="book-cover">
                        @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                        {
                            <img src="@book.CoverImageUrl" alt="@book.BookTitle" />
                        }
                        else
                        {
                            <div class="no-cover">Book</div>
                        }
                    </div>
                    <div class="book-info">
                        <h3 class="book-title">@book.BookTitle</h3>
                        <p class="book-author">@book.AuthorNames</p>
                        <div class="book-meta">
                            <span class="badge">@book.CategoryName</span>
                            <span class="badge">@book.GenreName</span>
                        </div>
                        <p class="book-copies">
                            <strong>Available:</strong> @book.AvailableCopies copies
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(Model.SearchTerm))
{
    <div class="search-results-section">
        <div class="search-results-header">
            <h2>No Results Found</h2>
            <p>No books found for "@Model.SearchTerm". Try a different search term.</p>
        </div>
    </div>
}

<!-- Book Details Modal -->
<div id="bookModal" class="modal" style="display: none;">
    <div class="modal-content">
        <span class="close-modal" onclick="closeBookModal()">&times;</span>
        <div id="modalBookDetails">
            <!-- Book details will be loaded here -->
        </div>
    </div>
</div>

<style>
    .search-results-section {
        max-width: 1200px;
        margin: 60px auto;
        padding: 0 20px;
    }

    .search-results-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .search-results-header h2 {
        color: #8B4049;
        font-size: 2.5rem;
        margin-bottom: 10px;
    }

    .search-results-header p {
        color: #666;
        font-size: 1.2rem;
    }

    .books-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
        padding: 20px 0;
    }

    .book-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .book-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 15px rgba(139, 64, 73, 0.2);
    }

    .book-cover {
        width: 100%;
        height: 300px;
        background: linear-gradient(135deg, #8B4049 0%, #FBDB93 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .book-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .no-cover {
        font-size: 4rem;
        color: white;
    }

    .book-info {
        padding: 20px;
    }

    .book-title {
        font-size: 1.3rem;
        font-weight: bold;
        color: #2c2c2c;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .book-author {
        color: #8B4049;
        font-size: 1rem;
        margin-bottom: 12px;
    }

    .book-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
    }

    .badge {
        display: inline-block;
        padding: 4px 12px;
        background-color: #FBDB93;
        color: #2c2c2c;
        border-radius: 15px;
        font-size: 0.85rem;
    }

    .book-copies {
        color: #666;
        font-size: 0.9rem;
        margin: 0;
    }

    /* Modal Styles */
    .modal {
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(5px);
        animation: fadeIn 0.3s ease;
    }

    .modal-content {
        background-color: #fefefe;
        margin: 5% auto;
        padding: 0;
        border-radius: 20px;
        width: 90%;
        max-width: 700px;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: 0 10px 50px rgba(0, 0, 0, 0.3);
        animation: slideUp 0.3s ease;
        position: relative;
    }

    .close-modal {
        position: sticky;
        top: 0;
        right: 0;
        float: right;
        font-size: 35px;
        font-weight: bold;
        color: #8B4049;
        cursor: pointer;
        padding: 15px 25px;
        z-index: 1001;
        background: white;
        border-radius: 0 20px 0 0;
    }

    .close-modal:hover {
        color: #2c2c2c;
    }

    #modalBookDetails {
        padding: 20px 40px 40px;
    }

    .modal-book-header {
        display: flex;
        gap: 30px;
        margin-bottom: 30px;
    }

    .modal-book-cover {
        flex-shrink: 0;
        width: 200px;
        height: 280px;
        background: linear-gradient(135deg, #8B4049 0%, #FBDB93 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .modal-book-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .modal-book-cover .no-cover {
        font-size: 5rem;
        color: white;
    }

    .modal-book-main {
        flex: 1;
    }

    .modal-book-title {
        font-size: 2rem;
        font-weight: bold;
        color: #2c2c2c;
        margin-bottom: 10px;
    }

    .modal-book-author {
        font-size: 1.2rem;
        color: #8B4049;
        margin-bottom: 15px;
    }

    .modal-book-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 15px;
    }

    .modal-book-details {
        background: #f9f9f9;
        padding: 20px;
        border-radius: 10px;
    }

    .detail-row {
        display: flex;
        padding: 10px 0;
        border-bottom: 1px solid #e0e0e0;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: bold;
        color: #8B4049;
        width: 140px;
        flex-shrink: 0;
    }

    .detail-value {
        color: #2c2c2c;
        flex: 1;
    }

    .modal-book-description {
        margin-top: 20px;
    }

    .modal-book-description h3 {
        color: #8B4049;
        margin-bottom: 10px;
    }

    .modal-book-description p {
        color: #666;
        line-height: 1.6;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes slideUp {
        from {
            transform: translateY(50px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @@media (max-width: 768px) {
        .books-grid {
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
        }

        .modal-content {
            width: 95%;
            margin: 10% auto;
        }

        .modal-book-header {
            flex-direction: column;
            align-items: center;
        }

        .modal-book-cover {
            width: 100%;
            max-width: 250px;
        }

        #modalBookDetails {
            padding: 20px;
        }
    }
</style>

<script>
    function showBookModal(bookId) {
        fetch(`/Books/Details?handler=BookDetails&id=${bookId}`)
            .then(response => response.json())
            .then(book => {
                const modalContent = `
                    <div class="modal-book-header">
                        <div class="modal-book-cover">
                            ${book.coverImageUrl 
                                ? `<img src="${book.coverImageUrl}" alt="${book.bookTitle}" />` 
                                : '<div class="no-cover">Book</div>'}
                        </div>
                        <div class="modal-book-main">
                            <h2 class="modal-book-title">${book.bookTitle}</h2>
                            <p class="modal-book-author">by ${book.authorNames || 'Unknown Author'}</p>
                            <div class="modal-book-badges">
                                ${book.categoryName ? `<span class="badge">${book.categoryName}</span>` : ''}
                                ${book.genreName ? `<span class="badge">${book.genreName}</span>` : ''}
                            </div>
                        </div>
                    </div>
                    <div class="modal-book-details">
                        ${book.isbn ? `
                        <div class="detail-row">
                            <span class="detail-label">ISBN:</span>
                            <span class="detail-value">${book.isbn}</span>
                        </div>` : ''}
                        ${book.publisher ? `
                        <div class="detail-row">
                            <span class="detail-label">Publisher:</span>
                            <span class="detail-value">${book.publisher}</span>
                        </div>` : ''}
                        ${book.publicationDate ? `
                        <div class="detail-row">
                            <span class="detail-label">Publication Date:</span>
                            <span class="detail-value">${new Date(book.publicationDate).toLocaleDateString()}</span>
                        </div>` : ''}
                        ${book.pageCount ? `
                        <div class="detail-row">
                            <span class="detail-label">Pages:</span>
                            <span class="detail-value">${book.pageCount}</span>
                        </div>` : ''}
                        <div class="detail-row">
                            <span class="detail-label">Available Copies:</span>
                            <span class="detail-value">${book.availableCopies}</span>
                        </div>
                    </div>
                    ${book.description ? `
                    <div class="modal-book-description">
                        <h3>Description</h3>
                        <p>${book.description}</p>
                    </div>` : ''}
                `;
                
                document.getElementById('modalBookDetails').innerHTML = modalContent;
                document.getElementById('bookModal').style.display = 'block';
            })
            .catch(error => {
                console.error('Error loading book details:', error);
                alert('Failed to load book details. Please try again.');
            });
    }

    function closeBookModal() {
        document.getElementById('bookModal').style.display = 'none';
    }

    // Close modal when clicking outside of it
    window.onclick = function(event) {
        const modal = document.getElementById('bookModal');
        if (event.target == modal) {
            closeBookModal();
        }
    }

    // Handle escape key to close modal
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeBookModal();
        }
    });
</script>


@if (userRole == "Member")
{
    <div class="container mt-5">
        <h2>Member Features</h2>
        <ul>
            <li><a href="/Books/Index">Browse Books</a></li>
            <li><a href="/Borrowing/Index">My Borrowing</a></li>
            <li><a href="/BookRequests/Index">Request a Book</a></li>
            <li><a href="/Fines/Index">My Fines</a></li>
            <li><a href="/Notifications/Index">My Notifications</a></li>
        </ul>
    </div>
}
else if (userRole == "Admin")
{
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-6">
                <h2>Library Management</h2>
                <ul>
                    <li><a href="/Books/Index">Books Management</a></li>
                    <li><a href="/Members/Index">Members Management</a></li>
                    <li><a href="/Borrowing/Index">Borrowing Transactions</a></li>
                    <li><a href="/BookRequests/Index">Book Requests</a></li>
                    <li><a href="/Fines/Index">Fines Management</a></li>
                    <li><a href="/Notifications/Index">Notifications</a></li>
                    <li><a href="/Reports/Index">Reports & Analytics</a></li>
                </ul>
            </div>
            <div class="col-md-6">
                <h2>Catalog Management</h2>
                <ul>
                    <li><a href="/Authors/Index">Authors</a></li>
                    <li><a href="/Categories/Index">Categories</a></li>
                    <li><a href="/Genres/Index">Genres</a></li>
                </ul>

                <h2 class="mt-4">Quick Stats</h2>
                <p>Total Books: @Model.TotalBooks</p>
                <p>Available Books: @Model.AvailableBooks</p>
                <p>Total Members: @Model.TotalMembers</p>
                <p>Active Transactions: @Model.ActiveTransactions</p>
                <p>Unpaid Fines: @Model.UnpaidFines</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-12 text-center">
                <h2>Discover Your Next Great Read</h2>
                <p class="lead">Browse our extensive collection of @Model.TotalBooks books with @Model.AvailableBooks currently available.</p>
                <p>Please <a href="/Account/Login">login</a> or <a href="/Account/Register">sign up</a> to start borrowing books and managing your reading journey!</p>
            </div>
        </div>
    </div>
}
