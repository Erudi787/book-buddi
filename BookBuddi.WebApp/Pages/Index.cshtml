<script>
    function showBookModal(bookId) {
        fetch(`/Books/Details?handler=BookDetails&id=${bookId}`)
            .then(response => response.json())
            .then(book => {
                const modalContent = `
                    <div class="modal-book-header">
                        <div class="modal-book-cover">
                            ${book.coverImageUrl
                        ? `<img src="${book.coverImageUrl}" alt="${book.bookTitle}" />`
                        : '<div class="no-cover">Book</div>'}
                        </div>
                        <div class="modal-book-main">
                            <h2 class="modal-book-title">${book.bookTitle}</h2>
                            <p class="modal-book-author">by ${book.authorNames || 'Unknown Author'}</p>
                            <div class="modal-book-badges">
                                ${book.categoryName ? `<span class="badge">${book.categoryName}</span>` : ''}
                                ${book.genreName ? `<span class="badge">${book.genreName}</span>` : ''}
                            </div>
                        </div>
                    </div>
                    <div class="modal-book-details">
                        ${book.isbn ? `
                        <div class="detail-row">
                            <span class="detail-label">ISBN:</span>
                            <span class="detail-value">${book.isbn}</span>
                        </div>` : ''}
                        ${book.publisher ? `
                        <div class="detail-row">
                            <span class="detail-label">Publisher:</span>
                            <span class="detail-value">${book.publisher}</span>
                        </div>` : ''}
                        ${book.publicationDate ? `
                        <div class="detail-row">
                            <span class="detail-label">Publication Date:</span>
                            <span class="detail-value">${new Date(book.publicationDate).toLocaleDateString()}</span>
                        </div>` : ''}
                        ${book.pageCount ? `
                        <div class="detail-row">
                            <span class="detail-label">Pages:</span>
                            <span class="detail-value">${book.pageCount}</span>
                        </div>` : ''}
                        <div class="detail-row">
                            <span class="detail-label">Available Copies:</span>
                            <span class="detail-value">${book.availableCopies}</span>
                        </div>
                    </div>
                    ${book.description ? `
                    <div class="modal-book-description">
                        <h3>Description</h3>
                        <p>${book.description}</p>
                    </div>` : ''}
                `;

                document.getElementById('modalBookDetails').innerHTML = modalContent;
                document.getElementById('bookModal').style.display = 'block';
            })
            .catch(error => {
                console.error('Error loading book details:', error);
                alert('Failed to load book details. Please try again.');
            });
    }

    function closeBookModal() {
        document.getElementById('bookModal').style.display = 'none';
    }

    // Close modal when clicking outside of it
    window.onclick = function (event) {
        const modal = document.getElementById('bookModal');
        if (event.target == modal) {
            closeBookModal();
        }
    }

    // Handle escape key to close modal
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeBookModal();
        }
    });

    // Real-time AJAX search functionality
    let searchTimeout;
    const searchInput = document.getElementById('searchInput');
    const categorySelect = document.querySelector('select[name="categoryId"]');
    const genreSelect = document.querySelector('select[name="genreId"]');
    const searchLoading = document.getElementById('searchLoading');
    const searchResultsContainer = document.getElementById('searchResultsContainer');
    const newArrivalsSection = document.querySelector('.new-arrivals-section');

    function performSearch() {
        const searchTerm = searchInput.value.trim();
        const categoryId = categorySelect.value;
        const genreId = genreSelect.value;

        // If no filters, show new arrivals and hide results
        if (!searchTerm && !categoryId && !genreId) {
            searchResultsContainer.innerHTML = '';
            if (newArrivalsSection) newArrivalsSection.style.display = 'block';
            return;
        }

        // Show loading indicator
        searchLoading.classList.add('show');
        searchResultsContainer.innerHTML = '';
        if (newArrivalsSection) newArrivalsSection.style.display = 'none';

        // Build query string
        const params = new URLSearchParams();
        if (searchTerm) params.append('searchTerm', searchTerm);
        if (categoryId) params.append('categoryId', categoryId);
        if (genreId) params.append('genreId', genreId);

        // Fetch search results via AJAX
        fetch(`/?handler=SearchBooks&${params.toString()}`)
            .then(response => response.json())
            .then(data => {
                // Hide loading indicator
                searchLoading.classList.remove('show');

                if (data.success && data.books && data.books.length > 0) {
                    // Build results HTML
                    let resultsHTML = `
                        <div class="search-results-section fade-in">
                            <div class="search-results-header">
                                <h2>Search Results</h2>
                                <p>Found ${data.count} book(s)${searchTerm ? ` for "${searchTerm}"` : ''}</p>
                            </div>
                            <div class="books-grid">`;

                    data.books.forEach(book => {
                        resultsHTML += `
                            <div class="book-card" onclick="showBookModal(${book.bookId})">
                                <div class="book-cover">
                                    ${book.coverImageUrl
                                ? `<img src="${book.coverImageUrl}" alt="${book.bookTitle}" />`
                                : '<div class="no-cover">Book</div>'}
                                </div>
                                <div class="book-info">
                                    <h3 class="book-title">${book.bookTitle}</h3>
                                    <p class="book-author">${book.authorNames || 'Unknown Author'}</p>
                                    <div class="book-meta">
                                        ${book.categoryName ? `<span class="badge">${book.categoryName}</span>` : ''}
                                        ${book.genreName ? `<span class="badge">${book.genreName}</span>` : ''}
                                    </div>
                                    <p class="book-copies">
                                        <strong>Available:</strong> ${book.availableCopies} copies
                                    </p>
                                </div>
                            </div>`;
                    });

                    resultsHTML += `
                            </div>
                        </div>`;

                    searchResultsContainer.innerHTML = resultsHTML;
                } else {
                    // No results found
                    searchResultsContainer.innerHTML = `
                        <div class="search-results-section fade-in">
                            <div class="search-results-header">
                                <h2>No Results Found</h2>
                                <p>No books found${searchTerm ? ` for "${searchTerm}"` : ''}. Try a different search term.</p>
                            </div>
                        </div>`;
                }
            })
            .catch(error => {
                console.error('Search error:', error);
                searchLoading.classList.remove('show');
                searchResultsContainer.innerHTML = `
                    <div class="search-results-section fade-in">
                        <div class="search-results-header">
                            <h2>Error</h2>
                            <p>An error occurred while searching. Please try again.</p>
                        </div>
                    </div>`;
            });
    }

    // Add event listeners for real-time search
    if (searchInput) {
        searchInput.addEventListener('input', function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(performSearch, 500); // 500ms delay
        });

        // Also trigger on Enter key
        searchInput.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                clearTimeout(searchTimeout);
                performSearch();
            }
        });
    }

    // Add event listeners for dropdowns
    if (categorySelect) {
        categorySelect.addEventListener('change', function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(performSearch, 300);
        });
    }

    if (genreSelect) {
        genreSelect.addEventListener('change', function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(performSearch, 300);
        });
    }
</script>


