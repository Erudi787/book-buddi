@page
@model BookBuddi.Pages.Authors.IndexModel
@{
    ViewData["Title"] = "Authors Management";
    var isAdmin = HttpContext.Session.GetString("UserRole") == "Admin";
    var colorTextSecondary = "#718096";
}
<link rel="stylesheet" href="~/css/authors-index.css" />

<div class="page-container">
    <div class="page-header">
        <div class="header-content">
            <h1>Authors Management</h1>
            <p>Manage your library's authors, biographies, and literary contributions</p>
        </div>
    </div>

    @if (!isAdmin)
    {
        <div class="access-denied">
            <div class="access-denied-icon">🔒</div>
            <h2>Admin Access Required</h2>
            <p>You need administrator privileges to access the authors management system.</p>
            <a href="/Account/Login" class="btn btn-primary">
                <i class="fas fa-sign-in-alt"></i> Login as Admin
            </a>
        </div>
    }
    else
    {

        <div class="content-section">
            <div class="action-bar">
                <h2 class="section-title">Authors Directory</h2>
                <div class="action-buttons">
                    <a href="/Authors/Create" class="btn btn-primary">
                        <i class="fas fa-plus-circle"></i> Add New Author
                    </a>
                    <a href="/" class="btn btn-outline">
                        <i class="fas fa-home"></i> Back to Home
                    </a>
                </div>
            </div>

            @if (Model.Authors != null && Model.Authors.Any())
            {
                <div class="table-container">
                    <table class="authors-table">
                        <thead>
                            <tr>
                                <th>Author ID</th>
                                <th>Name</th>
                                <th>Biography</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var author in Model.Authors)
                            {
                                <tr>
                                    <td>
                                        <span class="author-id">#@author.AuthorId</span>
                                    </td>
                                    <td>
                                        <div class="author-name">@author.FirstName @author.LastName</div>
                                    </td>
                                    <td>
                                        <div class="author-bio">
                                            @if (!string.IsNullOrEmpty(author.Biography))
                                            {
                                                if (author.Biography.Length > 150)
                                                {
                                                    @author.Biography.Substring(0, 150)
                                                    <span style="color: @colorTextSecondary;">...</span>
                                                }
                                                else
                                                {
                                                    @author.Biography
                                                }
                                            }
                                            else
                                            {
                                                <span style="color: @colorTextSecondary; font-style: italic;">No biography available</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="actions-cell">
                                        <div class="action-buttons-group">
                                            <a href="/Authors/Edit?id=@author.AuthorId" class="btn btn-edit">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <a href="/Authors/Delete?id=@author.AuthorId" class="btn btn-danger">
                                                <i class="fas fa-trash"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon">📝</div>
                    <h3>No Authors Found</h3>
                    <p>Get started by adding your first author to the library system. Authors help organize and categorize your book collection.</p>
                    <a href="/Authors/Create" class="btn btn-primary">
                        <i class="fas fa-plus-circle"></i> Add Your First Author
                    </a>
                </div>
            }
        </div>
    }
</div>