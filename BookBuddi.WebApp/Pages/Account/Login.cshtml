@page
@model BookBuddi.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In - bookBuddi";
    Layout = "_Layout";
}

<style>
    .login-container {
        display: flex;
        min-height: calc(100vh - 80px);
        margin: 0;
    }

    .login-left {
        flex: 1;
        background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: 80px;
    }

    .login-left h1 {
        font-size: 6rem;
        font-weight: 300;
        margin: 0;
        line-height: 1;
        color: #333;
    }

    .login-left .subtitle {
        font-size: 2.5rem;
        color: #8B4049;
        margin-top: 10px;
        font-weight: 300;
    }

    .login-right {
        flex: 1;
        background: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 80px;
        max-width: 600px;
    }

    .login-form h2 {
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 10px;
        color: #333;
    }

    .login-form .subtitle-text {
        color: #666;
        margin-bottom: 30px;
        font-size: 0.95rem;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #333;
        font-weight: 500;
        font-size: 0.95rem;
    }

    .form-group input {
        width: 100%;
        padding: 12px 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: border-color 0.3s;
        box-sizing: border-box;
    }

    .form-group input:focus {
        outline: none;
        border-color: #FBDB93;
    }

    .form-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        color: #666;
    }

    .remember-me input[type="checkbox"] {
        width: auto;
        margin: 0;
    }

    .btn-signin {
        width: 100%;
        padding: 14px;
        background-color: #FBDB93;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        color: #333;
        cursor: pointer;
        transition: background-color 0.3s;
        margin-top: 10px;
    }

    .btn-signin:hover {
        background-color: #f9d073;
    }

    .signup-link {
        text-align: center;
        margin-top: 20px;
        color: #666;
        font-size: 0.95rem;
    }

    .signup-link a {
        color: #8B4049;
        text-decoration: none;
        font-weight: 600;
    }

    .signup-link a:hover {
        text-decoration: underline;
    }

    .alert {
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .alert-danger {
        background-color: #fee;
        color: #c33;
        border: 1px solid #fcc;
    }

    .alert-success {
        background-color: #efe;
        color: #3c3;
        border: 1px solid #cfc;
    }
</style>

<div class="login-container">
    <div class="login-left">
        <h1>Welcome!</h1>
        <div class="subtitle">to bookbuddi</div>
    </div>

    <div class="login-right">
        <div class="login-form">
            <h2>Welcome Back</h2>
            <p class="subtitle-text">Sign in to continue the adventure</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success">@Model.SuccessMessage</div>
            }

            <form method="post" asp-page-handler="Login">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="you@example.com" required />
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="••••••••" required />
                </div>

                <div class="form-options">
                    <label class="remember-me">
                        <input type="checkbox" name="rememberMe" />
                        <span>Remember Me</span>
                    </label>
                </div>

                <button type="submit" class="btn-signin">Sign In</button>
            </form>

            <div class="signup-link">
                Don't have an account? <a href="/Account/Register">Sign Up</a>
            </div>
        </div>
    </div>
</div>
