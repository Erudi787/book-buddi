@page
@model BookBuddi.Pages.Account.EnterVerificationCodeModel
@{
    ViewData["Title"] = "Enter Verification Code";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Verify Your Email</h3>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill"></i> @Model.SuccessMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                        <div class="text-center mt-3">
                            <a href="/Account/Login" class="btn btn-primary">Go to Login</a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-envelope-fill"></i> A verification code has been sent to your email address.
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle-fill"></i> @Model.ErrorMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <form method="post" id="verificationForm">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">Email Address</label>
                                <input asp-for="Email" class="form-control" readonly />
                            </div>

                            <div class="mb-3">
                                <label asp-for="VerificationCode" class="form-label">Verification Code</label>
                                <input asp-for="VerificationCode"
                                       class="form-control form-control-lg text-center"
                                       style="letter-spacing: 10px; font-size: 24px; font-family: 'Courier New', monospace;"
                                       maxlength="6"
                                       placeholder="000000"
                                       autocomplete="off"
                                       autofocus />
                                <span asp-validation-for="VerificationCode" class="text-danger"></span>
                                <small class="form-text text-muted">Enter the 6-digit code from your email</small>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-check-circle"></i> Verify Email
                                </button>
                            </div>
                        </form>

                        <hr class="my-4">

                        <div class="text-center">
                            <p class="mb-2">Didn't receive the code?</p>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="resendButton">
                                <i class="bi bi-arrow-clockwise"></i> Resend Code
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <small class="text-muted">
                                Having trouble? <a href="/Account/Register">Register again</a> or <a href="/">Return home</a>
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-submit when 6 digits are entered
        document.getElementById('VerificationCode').addEventListener('input', function(e) {
            if (this.value.length === 6 && /^\d{6}$/.test(this.value)) {
                document.getElementById('verificationForm').submit();
            }
        });

        // Only allow digits
        document.getElementById('VerificationCode').addEventListener('keypress', function(e) {
            if (!/\d/.test(e.key) && e.key !== 'Backspace' && e.key !== 'Delete') {
                e.preventDefault();
            }
        });

        // Resend functionality (placeholder - implement backend handler)
        document.getElementById('resendButton')?.addEventListener('click', function() {
            alert('Resend functionality coming soon!');
        });
    </script>
}
