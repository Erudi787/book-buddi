@page
@model BookBuddi.Pages.Members.IndexModel
@{
    ViewData["Title"] = "Members";
}

<h1>Members Management</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p><a href="/Admin/CreateAccount">Add New Member</a></p>

<form method="get">
    <input type="text" name="searchTerm" placeholder="Search members..." value="@Model.SearchTerm" />
    <button type="submit">Search</button>
    <a href="/Members/Index">Clear</a>
</form>

<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th>Borrowed Books</th>
            <th>Borrowing Limit</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model.Members.Items)
        {
            <tr>
                <td>@member.MemberId</td>
                <td>@member.FirstName @member.LastName</td>
                <td>@member.Email</td>
                <td>@member.Phone</td>
                <td>@member.Status</td>
                <td>@member.CurrentBorrowedCount</td>
                <td>@member.BorrowingLimit</td>
                <td>
                    <a href="/Members/Edit?id=@member.MemberId">Edit</a> |
                    <a href="/Members/Details?id=@member.MemberId">Details</a> |
                    <a href="/Members/Suspend?id=@member.MemberId">Suspend</a> |
                    <a href="/Members/Reactivate?id=@member.MemberId">Reactivate</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@* Pagination Controls *@
<div style="margin: 20px 0; text-align: center;">
    <p>
        Showing @((Model.Members.PageNumber - 1) * Model.Members.PageSize + 1) -
        @Math.Min(Model.Members.PageNumber * Model.Members.PageSize, Model.Members.TotalCount)
        of @Model.Members.TotalCount members
    </p>

    @if (Model.Members.TotalPages > 1)
    {
        <div style="display: inline-block;">
            @if (Model.Members.HasPreviousPage)
            {
                <a href="?pageNumber=1&searchTerm=@Model.SearchTerm" style="padding: 5px 10px; margin: 0 2px; background-color: #007bff; color: white; text-decoration: none; border-radius: 3px;">First</a>
                <a href="?pageNumber=@(Model.Members.PageNumber - 1)&searchTerm=@Model.SearchTerm" style="padding: 5px 10px; margin: 0 2px; background-color: #007bff; color: white; text-decoration: none; border-radius: 3px;">Previous</a>
            }

            @for (int i = Math.Max(1, Model.Members.PageNumber - 2); i <= Math.Min(Model.Members.TotalPages, Model.Members.PageNumber + 2); i++)
            {
                if (i == Model.Members.PageNumber)
                {
                    <span style="padding: 5px 10px; margin: 0 2px; background-color: #28a745; color: white; border-radius: 3px; font-weight: bold;">@i</span>
                }
                else
                {
                    <a href="?pageNumber=@i&searchTerm=@Model.SearchTerm" style="padding: 5px 10px; margin: 0 2px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 3px;">@i</a>
                }
            }

            @if (Model.Members.HasNextPage)
            {
                <a href="?pageNumber=@(Model.Members.PageNumber + 1)&searchTerm=@Model.SearchTerm" style="padding: 5px 10px; margin: 0 2px; background-color: #007bff; color: white; text-decoration: none; border-radius: 3px;">Next</a>
                <a href="?pageNumber=@Model.Members.TotalPages&searchTerm=@Model.SearchTerm" style="padding: 5px 10px; margin: 0 2px; background-color: #007bff; color: white; text-decoration: none; border-radius: 3px;">Last</a>
            }
        </div>
    }
</div>

<p><a href="/">Back to Home</a></p>
