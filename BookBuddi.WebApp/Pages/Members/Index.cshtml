@page
@model BookBuddi.Pages.Members.IndexModel
@{
    ViewData["Title"] = "Members";
}

<link rel="stylesheet" href="~/css/member-index.css" />

<div class="page-wrapper" style="display: flex; gap: 20px; padding: 20px;">
    @await Html.PartialAsync("_AdminNavigation")

    <div class="members-container" style="flex: 1;">
    <div class="page-header">
        <h1>Members Management</h1>
        <p>Manage library members and their accounts</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" onclick="this.parentElement.style.display='none'">×</button>
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning">
            @TempData["WarningMessage"]
            <button type="button" class="btn-close" onclick="this.parentElement.style.display='none'">×</button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" onclick="this.parentElement.style.display='none'">×</button>
        </div>
    }

    <div class="action-bar">
        <a href="/Admin/CreateAccount" class="btn-primary">
            <span class="material-icons">person_add</span>
            Add New Member
        </a>
        
        <form method="get" class="search-form">
            <input type="text" name="searchTerm" class="search-input" placeholder="Search members by name or email..." value="@Model.SearchTerm" />
            <button type="submit" class="btn-secondary">
                <span class="material-icons">search</span>
                Search
            </button>
            <a href="/Members/Index" class="btn-link">Clear</a>
        </form>
    </div>

    <div class="table-container">
        <table class="members-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Borrowed</th>
                    <th>Limit</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model.Members.Items)
                {
                    <tr>
                        <td data-label="Name">@member.FirstName @member.LastName</td>
                        <td data-label="Email">@member.Email</td>
                        <td data-label="Phone">@member.Phone</td>
                        <td data-label="Status">
                            @{
                                var statusClass = member.Status.ToString().ToLower() switch
                                {
                                    "active" => "status-active",
                                    "suspended" => "status-suspended",
                                    "pending" => "status-pending",
                                    _ => "status-active"
                                };
                            }
                            <span class="status-badge @statusClass">@member.Status</span>
                        </td>
                        <td data-label="Borrowed">@member.CurrentBorrowedCount</td>
                        <td data-label="Limit">@member.BorrowingLimit</td>
                        <td data-label="Actions">
                            <div class="action-buttons">
                                <a href="/Members/Edit?id=@member.MemberId" class="action-btn" data-tooltip="Edit">
                                    <span class="material-icons icon">edit</span>
                                </a>
                                <a href="/Members/Details?id=@member.MemberId" class="action-btn" data-tooltip="Details">
                                    <span class="material-icons icon">visibility</span>
                                </a>
                                <a href="/Members/Suspend?id=@member.MemberId" class="action-btn danger" data-tooltip="Suspend">
                                    <span class="material-icons icon">block</span>
                                </a>
                                <a href="/Members/Reactivate?id=@member.MemberId" class="action-btn" data-tooltip="Reactivate">
                                    <span class="material-icons icon">check_circle</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination-container">
        <div class="pagination-info">
            Showing @((Model.Members.PageNumber - 1) * Model.Members.PageSize + 1) -
            @Math.Min(Model.Members.PageNumber * Model.Members.PageSize, Model.Members.TotalCount)
            of @Model.Members.TotalCount members
        </div>

        @if (Model.Members.TotalPages > 1)
        {
            <div class="pagination">
                @if (Model.Members.HasPreviousPage)
                {
                    <a href="?pageNumber=1&searchTerm=@Model.SearchTerm" class="page-link">First</a>
                    <a href="?pageNumber=@(Model.Members.PageNumber - 1)&searchTerm=@Model.SearchTerm" class="page-link">Previous</a>
                }

                @for (int i = Math.Max(1, Model.Members.PageNumber - 2); i <= Math.Min(Model.Members.TotalPages, Model.Members.PageNumber + 2); i++)
                {
                    <a href="?pageNumber=@i&searchTerm=@Model.SearchTerm" class="page-link @(i == Model.Members.PageNumber ? "active" : "")">@i</a>
                }

                @if (Model.Members.HasNextPage)
                {
                    <a href="?pageNumber=@(Model.Members.PageNumber + 1)&searchTerm=@Model.SearchTerm" class="page-link">Next</a>
                    <a href="?pageNumber=@Model.Members.TotalPages&searchTerm=@Model.SearchTerm" class="page-link">Last</a>
                }
            </div>
        }
    </div>

    <div class="footer">
        <a href="/" class="footer-link">
            <span class="material-icons">arrow_back</span>
            Back to Home
        </a>
    </div>
    </div>
</div>