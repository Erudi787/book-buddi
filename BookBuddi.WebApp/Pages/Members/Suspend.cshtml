@page
@model BookBuddi.Pages.Members.SuspendModel
@{
    ViewData["Title"] = "Suspend Member";
}

<link rel="stylesheet" href="~/css/member-suspend.css" />

<div class="page-wrapper" style="display: flex; gap: 20px; padding: 20px;">
    @await Html.PartialAsync("_AdminNavigation")

    <div class="suspend-member-container" style="flex: 1;">
    <div class="page-header">
        <h1>Suspend Member</h1>
        <p>Temporarily restrict member access and borrowing privileges</p>
    </div>

    <div class="warning-card">
        <div class="material-icons warning-icon">warning</div>
        <h3 class="warning-title">Confirm Member Suspension</h3>
        <p class="warning-message">
            This action will temporarily suspend the member's account. They will not be able to borrow books until the suspension is lifted.
        </p>
    </div>

    <div class="member-info-card">
        <div class="member-avatar">
            <span class="material-icons">person</span>
        </div>
        <div class="member-name">@Model.MemberName</div>
        <div class="member-id">Member ID: @Model.MemberId</div>
    </div>

    <form method="post" class="suspend-form">
        <input type="hidden" name="id" value="@Model.MemberId" />

        <div class="consequences-section">
            <div class="consequences-title">
                <span class="material-icons">info</span>
                Suspension Consequences
            </div>
            <ul class="consequences-list">
                <li class="consequence-item">Member will not be able to borrow new books</li>
                <li class="consequence-item">Member will not be able to place book reservations</li>
                <li class="consequence-item">Member will receive a notification about the suspension</li>
                <li class="consequence-item">Currently borrowed books must still be returned on time</li>
            </ul>
        </div>

        <div class="form-group">
            <label class="form-label required">
                <span class="material-icons">description</span>
                Reason for Suspension
            </label>
            <textarea name="reason" class="form-textarea" required 
                      placeholder="Please provide a detailed reason for suspending this member..."
                      maxlength="500"></textarea>
            <div class="char-counter" id="charCounter">
                <span id="charCount">0</span>/500 characters
            </div>
            <span class="helper-text">This reason will be recorded in the member's account history</span>
        </div>

        <div class="action-buttons">
            <a href="/Members/Index" class="btn btn-outline">
                <span class="material-icons">arrow_back</span>
                Cancel
            </a>
            <button type="submit" class="btn btn-danger" onclick="return confirmSuspension()">
                <span class="material-icons">block</span>
                Suspend Member
            </button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error-message">
            @Model.ErrorMessage
        </div>
    }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const reasonTextarea = document.querySelector('textarea[name="reason"]');
        const charCounter = document.getElementById('charCounter');
        const charCount = document.getElementById('charCount');

        // Character counter for reason field
        if (reasonTextarea && charCount) {
            reasonTextarea.addEventListener('input', function() {
                const length = this.value.length;
                charCount.textContent = length;
                
                // Update counter style
                charCounter.className = 'char-counter';
                if (length > 450) {
                    charCounter.classList.add('danger');
                } else if (length > 400) {
                    charCounter.classList.add('warning');
                }
            });
        }

        // Form validation
        const form = document.querySelector('.suspend-form');
        if (form) {
            form.addEventListener('submit', function(e) {
                const reason = reasonTextarea?.value.trim();
                
                if (!reason) {
                    e.preventDefault();
                    reasonTextarea?.focus();
                    reasonTextarea.style.borderColor = '#dc2626';
                    
                    // Show error message if not already shown
                    if (!document.querySelector('.error-message')) {
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'error-message';
                        errorDiv.innerHTML = '⚠️ Please provide a reason for suspension';
                        form.appendChild(errorDiv);
                    }
                }
            });

            // Real-time validation feedback
            if (reasonTextarea) {
                reasonTextarea.addEventListener('blur', function() {
                    validateField(this);
                });

                reasonTextarea.addEventListener('input', function() {
                    if (this.classList.contains('invalid')) {
                        validateField(this);
                    }
                });
            }

            function validateField(field) {
                if (field.required && !field.value.trim()) {
                    field.classList.add('invalid');
                    field.style.borderColor = '#dc2626';
                } else {
                    field.classList.remove('invalid');
                    field.style.borderColor = '';
                }
            }
        }

        // Keyboard navigation
        const actionButtons = document.querySelectorAll('.btn');
        actionButtons.forEach(button => {
            button.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    this.click();
                }
            });
        });

        // Escape key to cancel
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                window.location.href = '/Members/Index';
            }
        });
    });

    function confirmSuspension() {
        const memberName = '@Model.MemberName';
        const reason = document.querySelector('textarea[name="reason"]')?.value.trim();
        
        if (!reason) {
            alert('Please provide a reason for suspension before confirming.');
            return false;
        }

        return confirm(`Are you absolutely sure you want to suspend ${memberName}?\n\nReason: ${reason}\n\nThis action can be reversed by reactivating the member.`);
    }
</script>