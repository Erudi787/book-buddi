@page
@model BookBuddi.Pages.Members.CreateModel
@{
    ViewData["Title"] = "Register Member";
    // Color palette
    var colorTextSecondary = "#718096";
    var colorSuccess = "#10b981";
    var colorWarning = "#f59e0b";
    var colorDanger = "#ef4444";
}
<link rel="stylesheet" href="~/css/members-create.css" />

<div class="register-member-container">
    <div class="page-header">
        <h1>Register New Member</h1>
        <p>Create a new library member account</p>
    </div>

    <form method="post" class="member-form">
        <div class="form-grid">
            <!-- Personal Information -->
            <div class="form-group">
                <label class="form-label required">
                    <span class="material-icons">person</span>
                    First Name
                </label>
                <input type="text" class="form-input" asp-for="Member.FirstName" required 
                       placeholder="Enter first name" />
            </div>

            <div class="form-group">
                <label class="form-label required">
                    <span class="material-icons">person_outline</span>
                    Last Name
                </label>
                <input type="text" class="form-input" asp-for="Member.LastName" required 
                       placeholder="Enter last name" />
            </div>

            <div class="form-group">
                <label class="form-label required">
                    <span class="material-icons">email</span>
                    Email Address
                </label>
                <input type="email" class="form-input" asp-for="Member.Email" required 
                       placeholder="Enter email address" />
                <span class="helper-text">Used for login and notifications</span>
            </div>

            <div class="form-group">
                <label class="form-label">
                    <span class="material-icons">phone</span>
                    Phone Number
                </label>
                <input type="tel" class="form-input" asp-for="Member.Phone" 
                       placeholder="Enter phone number" />
            </div>

            <!-- Password Section -->
            <div class="form-group full-width">
                <label class="form-label required">
                    <span class="material-icons">lock</span>
                    Password
                </label>
                <input type="password" class="form-input" name="password" id="password" required 
                       minlength="8" placeholder="Create a secure password" />
                
                <div class="password-strength" id="passwordStrength">
                    <div class="strength-bar">
                        <div class="strength-fill"></div>
                    </div>
                    <div class="strength-text" id="strengthText">Password strength</div>
                </div>

                <div class="password-requirements">
                    <div class="requirement" id="reqLength">At least 8 characters</div>
                    <div class="requirement" id="reqUppercase">One uppercase letter</div>
                    <div class="requirement" id="reqLowercase">One lowercase letter</div>
                    <div class="requirement" id="reqDigit">One number</div>
                    <div class="requirement" id="reqSpecial">One special character</div>
                </div>
            </div>

            <!-- Address -->
            <div class="form-group full-width">
                <label class="form-label">
                    <span class="material-icons">home</span>
                    Address
                </label>
                <textarea class="form-textarea" asp-for="Member.Address" 
                          placeholder="Enter full address" rows="3"></textarea>
            </div>

            <!-- Date Information -->
            <div class="form-group">
                <label class="form-label">
                    <span class="material-icons">cake</span>
                    Date of Birth
                </label>
                <input type="date" class="form-input" asp-for="Member.DateOfBirth" 
                       max="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>

            <div class="form-group">
                <label class="form-label required">
                    <span class="material-icons">calendar_today</span>
                    Membership Expiry
                </label>
                <input type="date" class="form-input" asp-for="Member.MembershipExpiryDate" required 
                       min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span class="helper-text">Membership expiration date</span>
            </div>
        </div>

        <div class="action-buttons">
            <a href="/Members/Index" class="btn btn-outline">
                <span class="material-icons">arrow_back</span>
                Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <span class="material-icons">person_add</span>
                Register Member
            </button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error-message">
            @Model.ErrorMessage
        </div>
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const passwordInput = document.getElementById('password');
        const passwordStrength = document.getElementById('passwordStrength');
        const strengthText = document.getElementById('strengthText');
        const requirements = {
            length: document.getElementById('reqLength'),
            uppercase: document.getElementById('reqUppercase'),
            lowercase: document.getElementById('reqLowercase'),
            digit: document.getElementById('reqDigit'),
            special: document.getElementById('reqSpecial')
        };

        // Password strength and requirement checking
        if (passwordInput) {
            passwordInput.addEventListener('input', function() {
                const password = this.value;
                checkPasswordRequirements(password);
                updatePasswordStrength(password);
            });
        }

        function checkPasswordRequirements(password) {
            const checks = {
                length: password.length >= 8,
                uppercase: /[A-Z]/.test(password),
                lowercase: /[a-z]/.test(password),
                digit: /[0-9]/.test(password),
                special: /[^A-Za-z0-9]/.test(password)
            };

            // Update requirement indicators
            Object.keys(checks).forEach(key => {
                if (checks[key]) {
                    requirements[key].classList.add('met');
                } else {
                    requirements[key].classList.remove('met');
                }
            });

            return checks;
        }

        function updatePasswordStrength(password) {
            if (password.length === 0) {
                passwordStrength.className = 'password-strength';
                passwordStrength.querySelector('.strength-fill').style.width = '0%';
                strengthText.textContent = 'Password strength';
                strengthText.style.color = '@colorTextSecondary';
                return;
            }

            const checks = checkPasswordRequirements(password);
            const metCount = Object.values(checks).filter(Boolean).length;
            const totalCount = Object.keys(checks).length;

            if (metCount <= 2) {
                passwordStrength.className = 'password-strength strength-weak';
                strengthText.textContent = 'Weak password';
                strengthText.style.color = '@colorDanger';
            } else if (metCount <= 4) {
                passwordStrength.className = 'password-strength strength-medium';
                strengthText.textContent = 'Medium strength';
                strengthText.style.color = '@colorWarning';
            } else {
                passwordStrength.className = 'password-strength strength-strong';
                strengthText.textContent = 'Strong password';
                strengthText.style.color = '@colorSuccess';
            }
        }

        // Form validation
        const form = document.querySelector('.member-form');
        if (form) {
            form.addEventListener('submit', function(e) {
                const password = passwordInput?.value;
                const checks = checkPasswordRequirements(password || '');

                // Check if all requirements are met
                const allMet = Object.values(checks).every(Boolean);
                
                if (!allMet) {
                    e.preventDefault();
                    // Highlight unmet requirements
                    Object.keys(checks).forEach(key => {
                        if (!checks[key]) {
                            requirements[key].style.color = '@colorDanger';
                            requirements[key].style.fontWeight = '600';
                        }
                    });
                    
                    // Show error message
                    if (!document.querySelector('.error-message')) {
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'error-message';
                        errorDiv.innerHTML = '⚠️ Please meet all password requirements';
                        form.appendChild(errorDiv);
                    }
                    
                    passwordInput?.focus();
                }
            });
        }

        // Set minimum date for membership expiry to today
        const expiryInput = document.querySelector('input[asp-for="Member.MembershipExpiryDate"]');
        if (expiryInput) {
            const today = new Date().toISOString().split('T')[0];
            expiryInput.min = today;
        }

        // Set maximum date for date of birth to today
        const dobInput = document.querySelector('input[asp-for="Member.DateOfBirth"]');
        if (dobInput) {
            const today = new Date().toISOString().split('T')[0];
            dobInput.max = today;
        }
    });
</script>