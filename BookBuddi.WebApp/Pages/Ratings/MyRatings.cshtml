@page
@model BookBuddi.WebApp.Pages.Ratings.MyRatingsModel
@{
    ViewData["Title"] = "My Ratings";
}

<div class="container-fluid">
    <div class="page-header">
        <h1 class="page-title">My Ratings</h1>
        <p class="page-subtitle">View and manage your book ratings</p>
    </div>

    @if (Model.MyRatings.Any())
    {
        <div class="ratings-stats-card">
            <div class="stats-item">
                <div class="stats-label">Total Books Rated</div>
                <div class="stats-value">@Model.MyRatings.Count</div>
            </div>
            <div class="stats-item">
                <div class="stats-label">Your Average Rating</div>
                <div class="stats-value">
                    <span class="rating-stars" data-rating="@Model.AverageRating">
                        <div class="stars"></div>
                    </span>
                    <span class="rating-number">@Model.AverageRating.ToString("0.0")</span>
                </div>
            </div>
        </div>

        <div class="ratings-grid">
            @foreach (var rating in Model.MyRatings.OrderByDescending(r => r.RatedDate))
            {
                <div class="rating-card">
                    <div class="rating-card-image">
                        @if (!string.IsNullOrEmpty(rating.BookCoverUrl))
                        {
                            <img src="@rating.BookCoverUrl" alt="@rating.BookTitle" />
                        }
                        else
                        {
                            <div class="no-cover">No Cover</div>
                        }
                    </div>
                    <div class="rating-card-content">
                        <h3 class="rating-card-title">
                            <a href="/Books/Details?id=@rating.BookId">@rating.BookTitle</a>
                        </h3>
                        <div class="rating-card-rating">
                            <span class="rating-stars" data-rating="@rating.Score">
                                <div class="stars"></div>
                            </span>
                            <span class="rating-score">@rating.Score/5</span>
                        </div>
                        <div class="rating-card-date">
                            Rated on @rating.RatedDate.ToString("MMMM dd, yyyy")
                        </div>
                        <div class="rating-card-actions">
                            <button type="button" class="btn btn-sm btn-primary" 
                                    onclick="showRatingModal(@rating.BookId, '@rating.BookTitle.Replace("'", "\\'").Replace("\"", "&quot;")', @rating.Score, @rating.RatingId)">
                                Edit Rating
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" 
                                    onclick="deleteRating(@rating.RatingId)">
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">⭐</div>
            <h2 class="empty-state-title">No Ratings Yet</h2>
            <p class="empty-state-message">You haven't rated any books yet. Start exploring and rating books to see them here!</p>
            <a href="/Books/Index" class="btn btn-primary">Browse Books</a>
        </div>
    }
</div>

<!-- Rating Modal -->
<div id="ratingModal" class="rating-modal">
    <div class="rating-modal-content">
        <div class="rating-modal-header">
            <h3>Rate This Book</h3>
            <p class="book-title-display"></p>
        </div>
        <div class="rating-modal-body">
            <div id="ratingModalStars" class="rating-modal-stars">
                <span class="star interactive">☆</span>
                <span class="star interactive">☆</span>
                <span class="star interactive">☆</span>
                <span class="star interactive">☆</span>
                <span class="star interactive">☆</span>
            </div>
            <p class="rating-hint">Click a star to rate</p>
        </div>
        <div class="rating-modal-actions">
            <button type="button" class="btn btn-primary btn-rate-submit" onclick="submitRating()">Submit Rating</button>
            <button type="button" class="btn btn-secondary btn-rate-cancel" onclick="closeRatingModal()">Cancel</button>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/star-rating.css" />
    <script src="~/js/star-rating.js"></script>
}

<style>
    .ratings-stats-card {
        background: white;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 32px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        display: flex;
        gap: 48px;
        flex-wrap: wrap;
    }

    .stats-item {
        flex: 1;
        min-width: 200px;
    }

    .stats-label {
        font-size: 14px;
        color: #666;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .stats-value {
        font-size: 28px;
        font-weight: 700;
        color: #8B4049;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .rating-number {
        font-size: 24px;
        color: #333;
    }

    .ratings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 24px;
    }

    .rating-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .rating-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }

    .rating-card-image {
        width: 100%;
        height: 320px;
        overflow: hidden;
        background: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .rating-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .no-cover {
        color: #999;
        font-size: 14px;
        text-align: center;
    }

    .rating-card-content {
        padding: 16px;
    }

    .rating-card-title {
        font-size: 16px;
        font-weight: 600;
        margin: 0 0 12px 0;
        line-height: 1.4;
    }

    .rating-card-title a {
        color: #333;
        text-decoration: none;
        transition: color 0.2s;
    }

    .rating-card-title a:hover {
        color: #8B4049;
    }

    .rating-card-rating {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .rating-score {
        font-size: 16px;
        font-weight: 600;
        color: #8B4049;
    }

    .rating-card-date {
        font-size: 13px;
        color: #666;
        margin-bottom: 16px;
    }

    .rating-card-actions {
        display: flex;
        gap: 8px;
    }

    .rating-card-actions .btn {
        flex: 1;
        padding: 8px 12px;
        font-size: 14px;
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
    }

    .empty-state-icon {
        font-size: 64px;
        margin-bottom: 24px;
        opacity: 0.5;
    }

    .empty-state-title {
        font-size: 28px;
        font-weight: 700;
        color: #333;
        margin-bottom: 12px;
    }

    .empty-state-message {
        font-size: 16px;
        color: #666;
        margin-bottom: 32px;
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }

    @@media (max-width: 768px) {
        .ratings-grid {
            grid-template-columns: 1fr;
        }

        .ratings-stats-card {
            flex-direction: column;
            gap: 24px;
        }
    }
</style>
