@page
@model InventoryModel
@using BookBuddi.Data.Models
@{
    ViewData["Title"] = "Inventory Report";
}

<div class="report-container">
    <div class="report-header">
        <div class="header-left">
            <h1 class="report-title">Inventory Report</h1>
            <div class="tab-navigation">
                <a href="/Reports/Borrowing" class="tab">Borrowing</a>
                <a href="/Reports/Inventory" class="tab active">Inventory</a>
                <a href="/Reports/Members" class="tab">Members</a>
                <a href="/Reports/Requests" class="tab">Request</a>
            </div>
        </div>
    </div>

    <!-- Controls: Search, Filter, Export -->
    <div class="controls-top">
        <div class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" id="searchBox" placeholder="Search books..." />
        </div>

        <div class="filter-controls">
            <select id="statusFilter" class="filter-dropdown">
                <option value="">All Statuses</option>
                <option value="Available">Available</option>
                <option value="Borrowed">Currently Borrowed</option>
                <option value="Reserved">Reserved</option>
            </select>
        </div>

        <div class="action-buttons">
            <button class="btn-export btn-export-pdf">Export PDF</button>
            <button class="btn-export btn-export-csv">Export CSV</button>
        </div>
    </div>

    <div class="content-layout">
        <!-- Sidebar with Summary Cards -->
        <div class="summary-sidebar">
            <div class="summary-card @(Model.CurrentFilter=="All" ? "highlight-card" : "")" data-filter="All">
                <div class="card-icon">📚</div>
                <div class="card-text">
                    <h2>@Model.TotalBooks</h2>
                    <p>Total Books</p>
                </div>
            </div>
            <div class="summary-card @(Model.CurrentFilter=="Available" ? "highlight-card" : "")" data-filter="Available">
                <div class="card-icon">✅</div>
                <div class="card-text">
                    <h2>@Model.AvailableBooks</h2>
                    <p>Available</p>
                </div>
            </div>
            <div class="summary-card @(Model.CurrentFilter=="Borrowed" ? "highlight-card" : "")" data-filter="Borrowed">
                <div class="card-icon">📖</div>
                <div class="card-text">
                    <h2>@Model.CurrentlyBorrowed</h2>
                    <p>Currently Borrowed</p>
                </div>
            </div>
            <div class="summary-card @(Model.CurrentFilter=="Reserved" ? "highlight-card" : "")" data-filter="Reserved">
                <div class="card-icon">📝</div>
                <div class="card-text">
                    <h2>@Model.ReservedBooks</h2>
                    <p>Reserved</p>
                </div>
            </div>
        </div>

        <!-- Main Table -->
        <div class="main-content">
            <div class="table-container">
                <table class="report-table" id="inventoryTable">
                    <thead>
                        <tr>
                            <th>Book Title</th>
                            <th>Available</th>
                            <th>Borrowed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.BookList)
                        {
                            <tr>
                                <td>@b.BookTitle</td>
                                <td>@b.Available</td>
                                <td>@b.Borrowed</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>     
            <div class="action-buttons" style="justify-content: center; margin-top: 20px;">
                <a href="/Reports/Index" class="return-back-btn">
                    Return to Analytics
                </a>
            </div>
    </div>
        </div>
                </a>
            </div>
</div>

<style>
/* --- Reset & Layout --- */
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: "Instrument Sans", Roboto, Arial; color: #333; }

.report-container { width: 100%; min-height: 100vh; display: flex; flex-direction: column; background: #f5f6fa; }
.report-header { padding: 16px 32px; background: #f4d9a0; }
.header-left { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
.report-title { font-size: 28px; font-weight: 700; color: #2f2f2f; }

/* Tabs */
.tab-navigation { display: flex; gap: 12px; }
.tab { padding: 8px 20px; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 14px; background: #fff; color: #6b6b6b; box-shadow: 0 2px 6px rgba(62,45,45,0.04); transition: all 0.15s; }
.tab:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(62,45,45,0.08); }
.tab.active { background: #7d2e2e; color: #fff; box-shadow: none; }

/* Controls Top */
.controls-top { display:flex; gap:16px; align-items:center; padding:16px 32px; background:#fff; border-bottom:1px solid #eee; flex-wrap: wrap; }
.search-box { flex:1; position:relative; }
.search-box input { width:100%; padding:10px 12px 10px 36px; border-radius:999px; border:1px solid #e6e6e6; font-size:14px; }
.search-icon { position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#999; }

.filter-controls { display:flex; gap:12px; align-items:center; }
.filter-dropdown { padding:10px 14px; border-radius:8px; border:1px solid #e6e6e6; background:#fff; font-size:14px; appearance:none; }

.action-buttons { display:flex; gap:10px; }
.btn-export { padding:10px 18px; border-radius:8px; font-weight:700; font-size:13px; cursor:pointer; border:none; }
.btn-export-pdf { background:#7d2e2e;color:#fff; }
.btn-export-csv { background:#fff;color:#555;border:1px solid #e6e6e6; }

/* Content Layout */
.content-layout { display:flex; flex:1; gap:24px; padding:16px 32px; overflow:hidden; }
.summary-sidebar { flex:0 0 320px; display:flex; flex-direction:column; gap:18px; }
.summary-card { display:flex; align-items:center; gap:16px; padding:16px; border-radius:14px; background:#fff; box-shadow:0 6px 18px rgba(31,31,31,0.04); cursor:pointer; transition: all 0.2s; }
.summary-card .card-icon { width:58px;height:58px;display:flex;align-items:center;justify-content:center;background:#fafafa;border-radius:10px;font-size:28px; }
.summary-card h2 { font-size:32px; font-weight:800; color:#0b0b0b; }
.summary-card p { font-size:14px; font-weight:600; color:inherit; opacity:0.95; }
.highlight-card { background:#8A2D3B; color:#fff; }
.highlight-card .card-icon { background: rgba(255,255,255,0.12); font-size:30px; color:#fff; }
.highlight-card h2, .highlight-card p { color:#fff; }

/* Main Table */
.main-content { flex:1; display:flex; flex-direction:column; background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 6px 20px rgba(15,15,15,0.03); }
.table-container { flex:1; overflow:auto; padding:20px; }
.report-table { width:100%; border-collapse:collapse; min-width:500px; }
.report-table th, .report-table td { padding:12px; text-align:left; border-bottom:1px solid #eee; }
.report-table tbody tr:hover { background:#fafafa; }

/* Back Button */
.return-back-btn {
    margin: 0 auto; /* Add this line to center the button horizontally */
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #7d2e2e;
    color: #fff;
    padding: 14px 28px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(125, 46, 46, 0.18);
    transition: all 0.2s ease-in-out;
}

.return-back-btn:hover {
    background: #6b2626;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(125, 46, 46, 0.25);
}

.return-back-btn .material-icons {
    font-size: 20px;
}


/* Responsive */
@@media(max-width:1100px){.content-layout{padding:16px;gap:14px;}.summary-sidebar{width:260px;}}
@@media(max-width:880px){.content-layout{flex-direction:column;}.summary-sidebar{width:100%;flex-direction:row;overflow-x:auto;padding-bottom:8px;}.summary-card{min-width:180px;}}
</style>

<script>
const searchBox = document.getElementById('searchBox');
const statusFilter = document.getElementById('statusFilter');
const tableRows = document.querySelectorAll('#inventoryTable tbody tr');
const summaryCards = document.querySelectorAll('.summary-card');
const cardFilterMap = ["All","Available","Borrowed","Reserved"];
const btnExportCSV = document.querySelector('.btn-export-csv');
const btnExportPDF = document.querySelector('.btn-export-pdf');

function filterTable() {
    const searchTerm = searchBox.value.toLowerCase();
    const statusTerm = statusFilter.value;

    tableRows.forEach(row => {
        const bookTitle = row.cells[0].innerText.toLowerCase();
        const available = parseInt(row.cells[1].innerText);
        const borrowed = parseInt(row.cells[2].innerText);

        const statusMatch =
            statusTerm === "" ||
            (statusTerm==="Available" && available > 0) ||
            (statusTerm==="Borrowed" && borrowed > 0) ||
            (statusTerm==="Reserved" && available===0 && borrowed===0);

        const searchMatch = bookTitle.includes(searchTerm);

        row.style.display = (statusMatch && searchMatch) ? "" : "none";
    });

    summaryCards.forEach((card,index)=>{
        const cardFilter = cardFilterMap[index];
        if((statusTerm === "" && cardFilter==="All") || statusTerm===cardFilter) {
            card.classList.add("highlight-card");
        } else {
            card.classList.remove("highlight-card");
        }
    });
}

function exportCSV(){
    let csvContent = "data:text/csv;charset=utf-8,";
    csvContent += "Book Title,Available,Borrowed\n";

    tableRows.forEach(row=>{
        if(row.style.display!=="none"){
            const rowData = Array.from(row.cells)
                .map(cell => `"${cell.innerText.replace(/"/g,'""')}"`)
                .join(",");
            csvContent += rowData + "\n";
        }
    });

    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href",encodedUri);
    link.setAttribute("download","inventory_report.csv");
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

function exportPDF(){
    const originalContent = document.body.innerHTML;
    const tableContent = document.querySelector('.main-content').innerHTML;
    document.body.innerHTML = tableContent;
    window.print();
    document.body.innerHTML = originalContent;
    window.location.reload();
}

searchBox.addEventListener('input',filterTable);
statusFilter.addEventListener('change',filterTable);
btnExportCSV.addEventListener('click',exportCSV);
btnExportPDF.addEventListener('click',exportPDF);

// Initial state
filterTable();
</script>
