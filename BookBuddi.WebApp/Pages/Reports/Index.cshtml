@page
@model BookBuddi.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports";
}

<h1>Reports & Analytics</h1>

<div style="margin: 20px 0; padding: 15px; background: #f8f9fa; border-radius: 8px;">
    <h3 style="margin-top: 0;">Detailed Reports</h3>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <a href="/Reports/Borrowing" style="padding: 10px 20px; background: #8A2D3B; color: white; text-decoration: none; border-radius: 5px; font-weight: 600;">📚 Borrowing Report</a>
        <a href="/Reports/Inventory" style="padding: 10px 20px; background: #8A2D3B; color: white; text-decoration: none; border-radius: 5px; font-weight: 600;">📦 Inventory Report</a>
        <a href="/Reports/Members" style="padding: 10px 20px; background: #8A2D3B; color: white; text-decoration: none; border-radius: 5px; font-weight: 600;">👥 Members Report</a>
        <a href="/Reports/Requests" style="padding: 10px 20px; background: #8A2D3B; color: white; text-decoration: none; border-radius: 5px; font-weight: 600;">📝 Requests Report</a>
    </div>
</div>

<hr style="margin: 30px 0;" />

<h2 style="color: #555; margin-bottom: 20px;">📊 Quick Overview Statistics</h2>

<h3>Inventory Reports</h3>
<table border="1">
    <tr>
        <td><strong>Total Books:</strong></td>
        <td>@Model.TotalBooks</td>
    </tr>
    <tr>
        <td><strong>Available Books:</strong></td>
        <td>@Model.AvailableBooks</td>
    </tr>
    <tr>
        <td><strong>Borrowed Books:</strong></td>
        <td>@Model.BorrowedBooks</td>
    </tr>
</table>

<h3>Member Reports</h3>
<table border="1">
    <tr>
        <td><strong>Total Members:</strong></td>
        <td>@Model.TotalMembers</td>
    </tr>
    <tr>
        <td><strong>Active Members:</strong></td>
        <td>@Model.ActiveMembers</td>
    </tr>
</table>

<h3>Borrowing Activity</h3>
<table border="1">
    <tr>
        <td><strong>Active Transactions:</strong></td>
        <td>@Model.ActiveTransactions</td>
    </tr>
    <tr>
        <td><strong>Overdue Transactions:</strong></td>
        <td>@Model.OverdueTransactions</td>
    </tr>
</table>

<h3>Financial Reports</h3>
<table border="1">
    <tr>
        <td><strong>Total Unpaid Fines:</strong></td>
        <td>$@Model.UnpaidFinesAmount.ToString("F2")</td>
    </tr>
    <tr>
        <td><strong>Number of Unpaid Fines:</strong></td>
        <td>@Model.UnpaidFinesCount</td>
    </tr>
</table>

<h3>Book Request Reports</h3>
<table border="1">
    <tr>
        <td><strong>Pending Requests:</strong></td>
        <td>@Model.PendingRequests</td>
    </tr>
    <tr>
        <td><strong>Total Requests:</strong></td>
        <td>@Model.TotalRequests</td>
    </tr>
</table>

<p><a href="/">Back to Home</a></p>
