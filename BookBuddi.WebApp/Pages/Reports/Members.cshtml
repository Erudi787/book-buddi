@page
@model BookBuddi.WebApp.Pages.MembersModel
@using BookBuddi.Data.Models
@{
    ViewData["Title"] = "Member Report";
}

<div class="report-container">
    <div class="report-header">
        <h1 class="report-title">Book Report</h1>
        
        <!-- Tab Navigation -->
        <div class="tab-navigation">
            <a href="/Reports/Borrowing" class="tab">Borrowing</a>
            <a href="/Reports/Inventory" class="tab">Inventory</a>
            <a href="/Reports/Members" class="tab active">Members</a>
            <a href="/Reports/Requests" class="tab">Request</a>
            <a href="/Reports/LostBooks" class="tab">Lost Book</a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="summary-grid">
        <div class="summary-card total-members">
            <div class="card-content">
                <h2>@Model.TotalMembers</h2>
                <p>Total Members</p>
            </div>
        </div>

        <div class="summary-card active-members">
            <div class="card-content">
                <h2>@Model.ActiveMembers</h2>
                <p>Active Members</p>
            </div>
        </div>

        <div class="summary-card inactive-members">
            <div class="card-content">
                <h2>@Model.InactiveMembers</h2>
                <p>Inactive Members</p>
            </div>
        </div>

        <div class="summary-card total-borrowed">
            <div class="card-content">
                <h2>@Model.TotalBooksBorrowed</h2>
                <p>Total Book Borrowed</p>
            </div>
        </div>
    </div>

    <!-- Controls -->
    <div class="controls-bar">
        <div class="search-box">
            <input type="text" placeholder="Search for name or E-mail" />
        </div>
        
        <div class="filter-controls">
            <select class="filter-dropdown">
                <option>Status</option>
            </select>
            <select class="filter-dropdown">
                <option>Sort date</option>
            </select>
        </div>

        <div class="action-buttons">
            <button class="btn-export btn-export-pdf">Export PDF</button>
            <button class="btn-export btn-export-csv">Export CSV</button>
        </div>
    </div>

    <!-- Members Table -->
    <div class="table-container">
        <table class="report-table">
            <thead>
                <tr>
                    <th>Member ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Total Book Borrowed</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var m in Model.MemberList)
                {
                    <tr>
                        <td>@m.MemberId</td>
                        <td>@m.MemberName</td>
                        <td>@m.Email</td>
                        <td>@m.TotalBooksBorrowed</td>
                        <td>
                            <span class="status @m.StatusClass">@m.StatusText</span>
                        </td>
                        <td>
                            <button class="icon-btn action-btn">⋯</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .report-container {
        padding: 0;
        background: #f5f6fa;
        min-height: 100vh;
    }

    .report-header {
        padding: 30px;
        background: white;
        border-bottom: 1px solid #e0e0e0;
    }

    .report-title {
        font-size: 32px;
        margin: 0 0 20px 0;
        font-weight: bold;
        color: #2c3e50;
    }

    /* Tab Navigation */
    .tab-navigation {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .tab {
        padding: 10px 20px;
        background: #f0f0f0;
        border: none;
        border-radius: 20px;
        color: #666;
        text-decoration: none;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s;
    }

    .tab:hover {
        background: #e0e0e0;
    }

    .tab.active {
        background: #8b3a3a;
        color: white;
    }

    /* Summary Grid */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        padding: 30px;
        background: white;
        border-bottom: 1px solid #e0e0e0;
    }

    .summary-card {
        padding: 20px;
        background: #f9f9f9;
        border-radius: 8px;
        border-left: 4px solid #8b3a3a;
    }

    .card-content {
        text-align: center;
    }

    .summary-card h2 {
        font-size: 36px;
        margin: 0;
        font-weight: bold;
        color: #2c3e50;
    }

    .summary-card p {
        font-size: 14px;
        margin: 8px 0 0 0;
        color: #999;
    }

    /* Controls Bar */
    .controls-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 20px 30px;
        background: white;
        border-bottom: 1px solid #e0e0e0;
        flex-wrap: wrap;
    }

    .search-box input {
        width: 300px;
        padding: 10px 15px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
    }

    .filter-controls {
        display: flex;
        gap: 10px;
    }

    .filter-dropdown {
        padding: 10px 15px;
        border: 1px solid #ddd;
        border-radius: 6px;
        background: white;
        cursor: pointer;
        font-size: 14px;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
    }

    .btn-export {
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.3s;
    }

    .btn-export-pdf {
        background: #8b3a3a;
        color: white;
    }

    .btn-export-pdf:hover {
        background: #6d2e2e;
    }

    .btn-export-csv {
        background: white;
        color: #666;
        border: 1px solid #ddd;
    }

    .btn-export-csv:hover {
        background: #f5f5f5;
    }

    /* Table */
    .table-container {
        padding: 30px;
        background: white;
        overflow-x: auto;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .report-table th {
        background: #f5f5f5;
        padding: 15px;
        text-align: left;
        font-weight: 600;
        color: #2c3e50;
        border-bottom: 2px solid #e0e0e0;
    }

    .report-table td {
        padding: 15px;
        border-bottom: 1px solid #e0e0e0;
        color: #555;
    }

    .report-table tr:hover {
        background: #f9f9f9;
    }

    /* Status Badge */
    .status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 4px;
        font-size: 13px;
        font-weight: 600;
        color: white;
    }

    .status-active {
        background: #2ecc71;
    }

    .status-inactive {
        background: #e74c3c;
    }

    /* Action Buttons */
    .icon-btn {
        width: 32px;
        height: 32px;
        border: none;
        border-radius: 4px;
        background: #e0e0e0;
        color: #999;
        cursor: pointer;
        font-size: 18px;
        transition: all 0.3s;
    }

    .icon-btn:hover {
        background: #d0d0d0;
    }
</style>