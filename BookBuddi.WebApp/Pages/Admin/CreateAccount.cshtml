@page
@model BookBuddi.Pages.Admin.CreateAccountModel
@{
    ViewData["Title"] = "Create Account";
    // Color palette
    var colorTextSecondary = "#718096";
    var colorSuccess = "#10b981";
    var colorWarning = "#f59e0b";
    var colorDanger = "#ef4444";
}

<link rel="stylesheet" href="~/css/admin-createAccount.css" />

<div class="create-account-container">
    <div class="page-header">
        <h1>Create Account</h1>
        <p>Create new member or administrator accounts</p>
    </div>

    <div class="card">
        <div class="card-header">
            <h2>
                <span class="material-icons">person_add</span>
                Create New Account
            </h2>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    <span class="material-icons">error</span>
                    <span>@Model.ErrorMessage</span>
                    <button type="button" class="btn-close" onclick="this.parentElement.style.display='none'">×</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success">
                    <span class="material-icons">check_circle</span>
                    <span>@Model.SuccessMessage</span>
                    <button type="button" class="btn-close" onclick="this.parentElement.style.display='none'">×</button>
                </div>
            }

            <form method="post">
                <!-- Account Type Selection -->
                <div class="account-type-section">
                    <h3 class="section-title">
                        <span class="material-icons">category</span>
                        Account Type
                    </h3>
                    
                    <div class="account-type-grid">
                        <label class="account-type-card" id="memberCard">
                            <input class="account-type-radio" type="radio" name="AccountType" value="Member" checked asp-for="AccountType" />
                            <div class="account-type-content">
                                <div class="account-type-header">
                                    <div class="account-type-icon member-icon">
                                        <span class="material-icons">person</span>
                                    </div>
                                    <div>
                                        <div class="account-type-title">Member Account</div>
                                        <div class="account-type-description">Library member with borrowing privileges</div>
                                    </div>
                                </div>
                                <ul class="account-type-features">
                                    <li class="account-type-feature">Borrow books and materials</li>
                                    <li class="account-type-feature">Place reservations and holds</li>
                                    <li class="account-type-feature">Access member resources</li>
                                    <li class="account-type-feature">Receive notifications</li>
                                </ul>
                            </div>
                        </label>

                        <label class="account-type-card" id="adminCard">
                            <input class="account-type-radio" type="radio" name="AccountType" value="Admin" asp-for="AccountType" />
                            <div class="account-type-content">
                                <div class="account-type-header">
                                    <div class="account-type-icon admin-icon">
                                        <span class="material-icons">admin_panel_settings</span>
                                    </div>
                                    <div>
                                        <div class="account-type-title">Admin Account</div>
                                        <div class="account-type-description">Full system access and management</div>
                                    </div>
                                </div>
                                <ul class="account-type-features">
                                    <li class="account-type-feature">Manage all library operations</li>
                                    <li class="account-type-feature">Create and edit accounts</li>
                                    <li class="account-type-feature">Access admin dashboard</li>
                                    <li class="account-type-feature">System configuration</li>
                                </ul>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Basic Information -->
                <div class="form-section">
                    <h3 class="section-title">
                        <span class="material-icons">person</span>
                        Basic Information
                    </h3>
                    
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label required">First Name</label>
                            <input type="text" class="form-input" asp-for="FirstName" required 
                                   placeholder="Enter first name" />
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label required">Last Name</label>
                            <input type="text" class="form-input" asp-for="LastName" required 
                                   placeholder="Enter last name" />
                        </div>
                        
                        <div class="form-group full-width">
                            <label class="form-label required">Email Address</label>
                            <input type="email" class="form-input" asp-for="Email" required 
                                   placeholder="Enter email address" />
                            <span class="helper-text">This will be used for login and notifications</span>
                        </div>
                    </div>
                </div>

                <!-- Password Section -->
                <div class="form-section">
                    <h3 class="section-title">
                        <span class="material-icons">lock</span>
                        Security
                    </h3>
                    
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label required">Password</label>
                            <input type="password" class="form-input" id="Password" asp-for="Password" required 
                                   minlength="8" placeholder="Create a secure password" />
                            
                            <div class="password-strength" id="passwordStrength">
                                <div class="strength-bar">
                                    <div class="strength-fill"></div>
                                </div>
                                <div class="strength-text" id="strengthText">Password strength</div>
                            </div>

                            <div class="password-requirements">
                                <div class="requirement" id="reqLength">At least 8 characters</div>
                                <div class="requirement" id="reqUppercase">One uppercase letter</div>
                                <div class="requirement" id="reqLowercase">One lowercase letter</div>
                                <div class="requirement" id="reqDigit">One number</div>
                                <div class="requirement" id="reqSpecial">One special character</div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label required">Confirm Password</label>
                            <input type="password" class="form-input" id="ConfirmPassword" asp-for="ConfirmPassword" required 
                                   minlength="8" placeholder="Confirm your password" />
                            <span class="helper-text" id="passwordMatch">Re-enter the password</span>
                        </div>
                    </div>
                </div>

                <!-- Member Specific Fields -->
                <div class="member-fields" id="memberFields">
                    <div class="member-helper">
                        <p class="member-helper-text">
                            <span class="material-icons">info</span>
                            These fields are only required for Member accounts
                        </p>
                    </div>

                    <h4 class="member-section-title">
                        <span class="material-icons">card_membership</span>
                        Member Details
                    </h4>
                    
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Phone Number</label>
                            <input type="tel" class="form-input" asp-for="Phone" 
                                   placeholder="Enter phone number" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Date of Birth</label>
                            <input type="date" class="form-input" asp-for="DateOfBirth" 
                                   max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="form-group full-width">
                            <label class="form-label">Address</label>
                            <textarea class="form-textarea" asp-for="Address" 
                                      placeholder="Enter full address" rows="2"></textarea>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Borrowing Limit</label>
                            <input type="number" class="form-input" asp-for="BorrowingLimit" 
                                   min="1" max="20" value="5" />
                            <span class="helper-text">Maximum books that can be borrowed at once</span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Membership Expiry Date</label>
                            <input type="date" class="form-input" asp-for="MembershipExpiryDate" 
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span class="helper-text">When the membership expires</span>
                        </div>
                    </div>
                </div>

                <div class="action-buttons">
                    <a href="/Admin/Index" class="btn btn-outline">
                        <span class="material-icons">arrow_back</span>
                        Back to Dashboard
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <span class="material-icons">person_add</span>
                        Create Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const memberCard = document.getElementById('memberCard');
        const adminCard = document.getElementById('adminCard');
        const memberFields = document.getElementById('memberFields');
        const memberRadio = document.querySelector('input[value="Member"]');
        const adminRadio = document.querySelector('input[value="Admin"]');
        const passwordInput = document.getElementById('Password');
        const confirmPasswordInput = document.getElementById('ConfirmPassword');
        const passwordStrength = document.getElementById('passwordStrength');
        const strengthText = document.getElementById('strengthText');
        const passwordMatch = document.getElementById('passwordMatch');
        const requirements = {
            length: document.getElementById('reqLength'),
            uppercase: document.getElementById('reqUppercase'),
            lowercase: document.getElementById('reqLowercase'),
            digit: document.getElementById('reqDigit'),
            special: document.getElementById('reqSpecial')
        };

        // Account type selection
        function updateAccountTypeSelection() {
            if (memberRadio.checked) {
                memberCard.classList.add('selected');
                adminCard.classList.remove('selected');
                memberFields.classList.remove('hidden');
            } else {
                adminCard.classList.add('selected');
                memberCard.classList.remove('selected');
                memberFields.classList.add('hidden');
            }
        }

        memberCard.addEventListener('click', function() {
            memberRadio.checked = true;
            updateAccountTypeSelection();
        });

        adminCard.addEventListener('click', function() {
            adminRadio.checked = true;
            updateAccountTypeSelection();
        });

        // Initialize account type selection
        updateAccountTypeSelection();

        // Password strength and requirement checking
        if (passwordInput) {
            passwordInput.addEventListener('input', function() {
                const password = this.value;
                checkPasswordRequirements(password);
                updatePasswordStrength(password);
            });
        }

        // Password match indicator
        if (confirmPasswordInput && passwordInput) {
            confirmPasswordInput.addEventListener('input', function() {
                const password = passwordInput.value;
                const confirmPassword = this.value;
                
                if (confirmPassword === '') {
                    passwordMatch.textContent = 'Re-enter the password';
                    passwordMatch.style.color = '@colorTextSecondary';
                } else if (password === confirmPassword) {
                    passwordMatch.textContent = 'Passwords match';
                    passwordMatch.style.color = '@colorSuccess';
                } else {
                    passwordMatch.textContent = 'Passwords do not match';
                    passwordMatch.style.color = '@colorDanger';
                }
            });
        }

        function checkPasswordRequirements(password) {
            const checks = {
                length: password.length >= 8,
                uppercase: /[A-Z]/.test(password),
                lowercase: /[a-z]/.test(password),
                digit: /[0-9]/.test(password),
                special: /[^A-Za-z0-9]/.test(password)
            };

            // Update requirement indicators
            Object.keys(checks).forEach(key => {
                if (checks[key]) {
                    requirements[key].classList.add('met');
                } else {
                    requirements[key].classList.remove('met');
                }
            });

            return checks;
        }

        function updatePasswordStrength(password) {
            if (password.length === 0) {
                passwordStrength.className = 'password-strength';
                passwordStrength.querySelector('.strength-fill').style.width = '0%';
                strengthText.textContent = 'Password strength';
                strengthText.style.color = '@colorTextSecondary';
                return;
            }

            const checks = checkPasswordRequirements(password);
            const metCount = Object.values(checks).filter(Boolean).length;
            const totalCount = Object.keys(checks).length;

            if (metCount <= 2) {
                passwordStrength.className = 'password-strength strength-weak';
                strengthText.textContent = 'Weak password';
                strengthText.style.color = '@colorDanger';
            } else if (metCount <= 4) {
                passwordStrength.className = 'password-strength strength-medium';
                strengthText.textContent = 'Medium strength';
                strengthText.style.color = '@colorWarning';
            } else {
                passwordStrength.className = 'password-strength strength-strong';
                strengthText.textContent = 'Strong password';
                strengthText.style.color = '@colorSuccess';
            }
        }

        // Form validation
        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function(e) {
                const password = passwordInput?.value;
                const confirmPassword = confirmPasswordInput?.value;
                
                // Check password match
                if (password !== confirmPassword) {
                    e.preventDefault();
                    passwordMatch.textContent = 'Passwords do not match';
                    passwordMatch.style.color = '@colorDanger';
                    confirmPasswordInput?.focus();
                }
            });
        }

        // Set maximum date for date of birth to today
        const dobInput = document.querySelector('input[asp-for="DateOfBirth"]');
        if (dobInput) {
            const today = new Date().toISOString().split('T')[0];
            dobInput.max = today;
        }

        // Set minimum date for membership expiry to today
        const expiryInput = document.querySelector('input[asp-for="MembershipExpiryDate"]');
        if (expiryInput) {
            const today = new Date().toISOString().split('T')[0];
            expiryInput.min = today;
        }
    });
</script>