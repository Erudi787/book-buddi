@page
@model BookBuddi.Pages.Admin.ManageAdminsModel
@{
    ViewData["Title"] = "Manage Administrators";
}

<link rel="stylesheet" href="~/css/admin-manage.css" />

<div class="manage-admins-container">
    <div class="page-header">
        <div>
            <h1>Manage Administrators</h1>
            <p>Manage admin accounts and their access permissions</p>
        </div>
        <a href="/Admin/CreateAccount" class="btn-primary">
            <span class="material-icons">person_add</span>
            Create New Admin
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            <span class="material-icons">check_circle</span>
            <span>@Model.SuccessMessage</span>
            <button type="button" class="btn-close" onclick="this.parentElement.style.display='none'">×</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <span class="material-icons">error</span>
            <span>@Model.ErrorMessage</span>
            <button type="button" class="btn-close" onclick="this.parentElement.style.display='none'">×</button>
        </div>
    }

    <div class="table-container">
        @if (Model.Admins.Count == 0)
        {
            <div class="empty-state">
                <div class="material-icons empty-state-icon">admin_panel_settings</div>
                <h3>No Administrators Found</h3>
                <p>Get started by creating the first administrator account.</p>
                <a href="/Admin/CreateAccount" class="btn-primary">
                    <span class="material-icons">person_add</span>
                    Create First Admin
                </a>
            </div>
        }
        else
        {
            <table class="admins-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Last Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var admin in Model.Admins)
                    {
                        <tr>
                            <td data-label="Name">
                                <strong>@admin.FirstName @admin.LastName</strong>
                            </td>
                            <td data-label="Email">@admin.Email</td>
                            <td data-label="Status">
                                <span class="status-badge @(admin.IsActive ? "status-active" : "status-inactive")">
                                    @(admin.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td data-label="Created">
                                <small>@admin.DateCreated.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td data-label="Updated">
                                <small>@admin.UpdatedTime.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td data-label="Actions">
                                <div class="action-buttons">
                                    <a href="/Admin/EditAdmin?id=@admin.Id" class="action-btn" title="Edit Admin">
                                        <span class="material-icons icon">edit</span>
                                        Edit
                                    </a>
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-adminId="@admin.Id" style="display: inline;">
                                        @if (admin.IsActive)
                                        {
                                            <button type="submit" class="action-btn warning" title="Deactivate Admin"
                                                    onclick="return confirm('Are you sure you want to deactivate @admin.FirstName @admin.LastName?')">
                                                <span class="material-icons icon">toggle_off</span>
                                                Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="action-btn success" title="Activate Admin"
                                                    onclick="return confirm('Are you sure you want to activate @admin.FirstName @admin.LastName?')">
                                                <span class="material-icons icon">toggle_on</span>
                                                Activate
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="footer">
        <a href="/Admin/Index" class="btn-secondary">
            <span class="material-icons">arrow_back</span>
            Back to Dashboard
        </a>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Add confirmation for status toggle actions
        const toggleButtons = document.querySelectorAll('.action-btn.warning, .action-btn.success');
        
        toggleButtons.forEach(button => {
            button.addEventListener('click', function(e) {
                const action = this.classList.contains('warning') ? 'deactivate' : 'activate';
                const adminName = this.closest('tr').querySelector('td:first-child strong').textContent;
                
                if (!confirm(`Are you sure you want to ${action} ${adminName}?`)) {
                    e.preventDefault();
                }
            });
        });

        // Keyboard navigation
        const actionButtons = document.querySelectorAll('.action-btn');
        actionButtons.forEach(button => {
            button.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    this.click();
                }
            });
        });
    });
</script>