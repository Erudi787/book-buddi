@page
@model BookBuddi.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var colorPrimary = "#641B2E";   
}
<link rel="stylesheet" href="~/css/admin-index.css" />

<div class="dashboard-header">
    <div class="header-content">
        <h1>BookBuddi Admin Console</h1>
        <p>Welcome to your command center. Monitor library performance, manage operations, and track key metrics in real-time.</p>
        
        <div class="header-stats">
            <div class="header-stat">
                <i class="fas fa-book-open"></i>
                <span class="header-stat-value">@Model.TotalBooks</span>
                <span class="header-stat-label">Total Books</span>
            </div>
            <div class="header-stat">
                <i class="fas fa-users"></i>
                <span class="header-stat-value">@Model.TotalMembers</span>
                <span class="header-stat-label">Active Members</span>
            </div>
            <div class="header-stat">
                <i class="fas fa-check-circle"></i>
                <span class="header-stat-value">@Model.AvailableBooks</span>
                <span class="header-stat-label">Available Now</span>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-container">
    
    <div class="sidebar">
        <div class="sidebar-title">Quick Actions</div>
        <a href="/Borrowing/Borrow" class="quick-action-btn highlight">
            <i class="fas fa-sign-out-alt"></i> Process Borrow
        </a>
        <a href="/Borrowing/Return" class="quick-action-btn highlight">
            <i class="fas fa-sign-in-alt"></i> Process Return
        </a>
        <a href="/Books/Create" class="quick-action-btn">
            <i class="fas fa-plus-square"></i> Add New Book
        </a>
        <a href="/Members/Index" class="quick-action-btn">
            <i class="fas fa-users"></i> Manage Members
        </a>
        <a href="/BookRequests/Index" class="quick-action-btn warning">
            <i class="fas fa-bell"></i> View Requests 
            <span style="margin-left: auto; font-weight: 900; color: #e74a3b;">(@Model.PendingRequests)</span>
        </a>
        <a href="/Reports/Index" class="quick-action-btn">
            <i class="fas fa-chart-line"></i> Full Reports
        </a>
        <a href="/Admin/ManageAdmins" class="quick-action-btn">
            <i class="fas fa-shield-alt"></i> Manage Admins
        </a>
        <a href="/Categories/Index" class="quick-action-btn">
            <i class="fas fa-tags"></i> Manage Catalog
        </a>
        <a href="/Fines/Index" class="quick-action-btn danger">
            <i class="fas fa-money-check-alt"></i> Manage Fines
        </a>
    </div>

    <div class="main-content">
        
        <h2 class="section-title">
            <div class="section-icon">📈</div>
            Key Performance Indicators
        </h2>
        <div class="kpi-container">
            <div class="kpi-tile danger">
                <div class="kpi-tile-icon"><i class="fas fa-clock"></i></div>
                <div class="kpi-tile-value">@Model.OverdueTransactions</div>
                <div class="kpi-tile-header">Overdue Books</div>
            </div>
            <div class="kpi-tile warning">
                <div class="kpi-tile-icon"><i class="fas fa-hand-holding-usd"></i></div>
                <div class="kpi-tile-value">$@Model.TotalUnpaidFines.ToString("F2")</div>
                <div class="kpi-tile-header">Unpaid Fines</div>
            </div>
            <div class="kpi-tile success">
                <div class="kpi-tile-icon"><i class="fas fa-check-circle"></i></div>
                <div class="kpi-tile-value">@Model.AvailableBooks</div>
                <div class="kpi-tile-header">Books Available</div>
            </div>
            <div class="kpi-tile">
                <div class="kpi-tile-icon"><i class="fas fa-user-plus"></i></div>
                <div class="kpi-tile-value">@Model.NewMembersThisWeek</div>
                <div class="kpi-tile-header">New Members</div>
            </div>
        </div>

        <h2 class="section-title">
            <div class="section-icon">📊</div>
            Library Analytics
        </h2>
        <div class="tile-grid">
            
            <div class="category-tile">
                <div class="tile-header">
                    <i class="fas fa-book-open" style="color: @colorPrimary;"></i>
                    Inventory Overview
                </div>
                <div class="stats-container">
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-book"></i>Total Books</span>
                        <span class="stat-value">@Model.TotalBooks</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-sign-out-alt"></i>Borrowed Books</span>
                        <span class="stat-value">@Model.BorrowedBooks</span>
                    </div>
                    <div class="stat-item danger">
                        <span class="stat-label"><i class="fas fa-trash-alt"></i>Lost/Damaged</span>
                        <span class="stat-value">@(Model.LostBooks + Model.DamagedBooks)</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-calendar-plus"></i>New This Week</span>
                        <span class="stat-value">@Model.NewBooksThisWeek</span>
                    </div>
                </div>
            </div>
            
            <div class="category-tile">
                <div class="tile-header">
                    <i class="fas fa-exchange-alt" style="color: @colorPrimary;"></i>
                    Loan Operations
                </div>
                <div class="stats-container">
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-sync-alt"></i>Active Loans</span>
                        <span class="stat-value">@Model.ActiveTransactions</span>
                    </div>
                    <div class="stat-item danger">
                        <span class="stat-label"><i class="fas fa-exclamation-circle"></i>Overdue</span>
                        <span class="stat-value">@Model.OverdueTransactions</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-calendar-check"></i>Returned Today</span>
                        <span class="stat-value">@Model.CompletedTransactionsToday</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-chart-bar"></i>This Week's Borrowings</span>
                        <span class="stat-value">@Model.BorrowingsThisWeek</span>
                    </div>
                </div>
            </div>

            <div class="category-tile">
                <div class="tile-header">
                    <i class="fas fa-users" style="color: @colorPrimary;"></i>
                    Member Insights
                </div>
                <div class="stats-container">
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-user-friends"></i>Total Members</span>
                        <span class="stat-value">@Model.TotalMembers</span>
                    </div>
                    <div class="stat-item warning">
                        <span class="stat-label"><i class="fas fa-user-slash"></i>Suspended Accounts</span>
                        <span class="stat-value">@Model.SuspendedMembers</span>
                    </div>
                    <div class="stat-item warning">
                        <span class="stat-label"><i class="fas fa-hourglass-half"></i>Pending Requests</span>
                        <span class="stat-value">@Model.PendingRequests</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-thumbs-up"></i>Approved Requests</span>
                        <span class="stat-value">@Model.ApprovedRequests</span>
                    </div>
                </div>
            </div>
            
            <div class="category-tile">
                <div class="tile-header">
                    <i class="fas fa-money-bill-wave" style="color: @colorPrimary;"></i>
                    Financial Summary
                </div>
                <div class="stats-container">
                    <div class="stat-item danger">
                        <span class="stat-label"><i class="fas fa-money-check-alt"></i>Unpaid Fines</span>
                        <span class="stat-value">$@Model.TotalUnpaidFines.ToString("F2")</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-receipt"></i>Collected Today</span>
                        <span class="stat-value">$@Model.TotalPaidFinesToday.ToString("F2")</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-funnel-dollar"></i>Total Collected</span>
                        <span class="stat-value">$@Model.TotalFinesCollected.ToString("F2")</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label"><i class="fas fa-list-ol"></i>Outstanding Fines</span>
                        <span class="stat-value">@Model.UnpaidFinesCount</span>
                    </div>
                </div>
            </div>
        </div>

        <h2 class="section-title">
            <div class="section-icon">🔔</div>
            Recent Activity
        </h2>
        <div class="activity-feed">
            <div class="tile-header" style="border: none; margin-bottom: 5px; color: @colorPrimary;">
                <i class="fas fa-history" style="color: @colorPrimary;"></i>
                Latest Transactions
            </div>
            <ul>
                <li>
                    <span class="activity-detail">
                        <span class="activity-type borrow">Borrow</span>
                        <i class="fas fa-book" style="color: @colorPrimary;"></i>
                        The Great Gatsby
                    </span>
                    <span class="activity-meta">Member ID: M-105 | 5 min ago</span>
                </li>
                <li>
                    <span class="activity-detail">
                        <span class="activity-type return">Return</span>
                        <i class="fas fa-book" style="color: #d4a862;"></i>
                        Moby Dick
                    </span>
                    <span class="activity-meta">Member ID: M-210 | 1 hour ago</span>
                </li>
                <li>
                    <span class="activity-detail">
                        <span class="activity-type fine">Fine</span>
                        <i class="fas fa-dollar-sign" style="color: #e74a3b;"></i>
                        $5.00 Collected
                    </span>
                    <span class="activity-meta">Member ID: M-078 | 2 hours ago</span>
                </li>
                <li>
                    <span class="activity-detail">
                        <span class="activity-type borrow">Borrow</span>
                        <i class="fas fa-book" style="color: @colorPrimary;"></i>
                        Pride and Prejudice
                    </span>
                    <span class="activity-meta">Member ID: M-112 | 4 hours ago</span>
                </li>
                <li>
                    <span class="activity-detail">
                        <span class="activity-type return">Return</span>
                        <i class="fas fa-book" style="color: #d4a862;"></i>
                        1984
                    </span>
                    <span class="activity-meta">Member ID: M-180 | 1 day ago</span>
                </li>
            </ul>
        </div>

        <div class="action-buttons">
            <a href="/" class="btn btn-outline">
                <i class="fas fa-home"></i> Back to Home
            </a>
            <a href="/Reports/Index" class="btn btn-primary">
                <i class="fas fa-chart-line"></i> View Full Reports
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/your-font-awesome-kit-code.js" crossorigin="anonymous"></script>
}