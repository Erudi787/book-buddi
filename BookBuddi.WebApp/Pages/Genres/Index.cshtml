@page
@model BookBuddi.Pages.Genres.IndexModel
@{
    ViewData["Title"] = "Genres Management";
    var isAdmin = HttpContext.Session.GetString("UserRole") == "Admin";
}

<h1>Genres Management</h1>

@if (!isAdmin)
{
    <p style="color: red;">Admin access required to manage genres.</p>
    <p><a href="/Admin/Login">Login as Admin</a></p>
}
else
{
    <div style="margin-bottom: 20px;">
        <a href="/Genres/Create" style="padding: 10px 15px; background-color: #007bff; color: white; text-decoration: none; border-radius: 5px;">Add New Genre</a>
    </div>

    <div style="margin-bottom: 20px;">
        <form method="get">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search genres..." style="padding: 8px; width: 300px;" />
            <button type="submit" style="padding: 8px 15px;">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a href="/Genres/Index">Clear</a>
            }
        </form>
    </div>

    @if (Model.Genres.Any())
    {
        <table border="1" style="width: 100%; border-collapse: collapse;">
            <thead style="background-color: #f8f9fa;">
                <tr>
                    <th style="padding: 10px;">ID</th>
                    <th style="padding: 10px;">Genre Name</th>
                    <th style="padding: 10px;">Description</th>
                    <th style="padding: 10px;">Created By</th>
                    <th style="padding: 10px;">Created Date</th>
                    <th style="padding: 10px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var genre in Model.Genres)
                {
                    <tr>
                        <td style="padding: 10px;">@genre.GenreId</td>
                        <td style="padding: 10px;"><strong>@genre.GenreName</strong></td>
                        <td style="padding: 10px;">@(genre.GenreDescription ?? "-")</td>
                        <td style="padding: 10px;">@genre.CreatedBy</td>
                        <td style="padding: 10px;">@genre.CreatedTime.ToString("MMM dd, yyyy")</td>
                        <td style="padding: 10px;">
                            <a href="/Genres/Edit?id=@genre.GenreId">Edit</a> |
                            <a href="/Genres/Delete?id=@genre.GenreId" style="color: red;">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No genres found.</p>
    }
}

<p style="margin-top: 20px;"><a href="/">Back to Home</a></p>
