@page
@model BookBuddi.Pages.Genres.DeleteModel
@{
    ViewData["Title"] = "Delete Genre";
    var isAdmin = HttpContext.Session.GetString("UserRole") == "Admin";
}
<link rel="stylesheet" href="~/css/genres-delete.css" />

<div class="page-wrapper" style="display: flex; gap: 20px; padding: 20px;">
    @await Html.PartialAsync("_AdminNavigation")

    <div class="page-container" style="flex: 1;">
    <div class="page-header">
        <h1>Delete Genre</h1>
        <p>Permanently remove a genre from the BookBuddi library system</p>
    </div>

    @if (!isAdmin)
    {
        <div class="access-denied">
            <div class="access-denied-icon">🚫</div>
            <h2>Admin Access Required</h2>
            <p>You need administrator privileges to delete genres from the library system.</p>
            <a href="/Account/Login" class="btn btn-danger">
                <i class="fas fa-sign-in-alt"></i> Login as Admin
            </a>
        </div>
    }
    else
    {
        <div class="warning-alert">
            <div class="warning-icon">⚠️</div>
            <h3>Critical Action Required</h3>
            <p>You are about to permanently delete this genre from the system. This action cannot be undone.</p>
            
            <div class="warning-features">
                <div class="warning-feature">
                    <i class="fas fa-ban"></i>
                    <span>Permanent Deletion</span>
                </div>
                <div class="warning-feature">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>Cannot Be Undone</span>
                </div>
                <div class="warning-feature">
                    <i class="fas fa-books"></i>
                    <span>Affects Book Categorization</span>
                </div>
            </div>
        </div>

        <div class="genre-card">
            <div class="card-header">
                <div class="genre-icon">@Model.Genre.GenreName.Substring(0, 1).ToUpper()</div>
                <div class="genre-title">
                    <h2>@Model.Genre.GenreName</h2>
                    <div class="genre-id">Genre ID: #@Model.Genre.GenreId</div>
                </div>
            </div>

            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fas fa-fingerprint"></i>
                        Genre ID
                    </div>
                    <div class="detail-value">#@Model.Genre.GenreId</div>
                </div>
                
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fas fa-tag"></i>
                        Genre Name
                    </div>
                    <div class="detail-value">@Model.Genre.GenreName</div>
                </div>
                
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fas fa-user"></i>
                        Created By
                    </div>
                    <div class="detail-value">@Model.Genre.CreatedBy</div>
                </div>
                
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="fas fa-calendar"></i>
                        Created Date
                    </div>
                    <div class="detail-value">@Model.Genre.CreatedTime.ToString("MMM dd, yyyy")</div>
                </div>
                
                <div class="detail-item description-item">
                    <div class="detail-label">
                        <i class="fas fa-align-left"></i>
                        Description
                    </div>
                    <div class="detail-value">
                        @if (!string.IsNullOrEmpty(Model.Genre.GenreDescription))
                        {
                            @Model.Genre.GenreDescription
                        }
                        else
                        {
                            <span class="empty-description">No description provided</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <form method="post" id="deleteForm">
            <input type="hidden" name="id" value="@Model.Genre.GenreId" />
            
            <div class="confirmation-check">
                <div class="confirmation-label" onclick="toggleConfirmation()">
                    <div class="confirmation-checkbox" id="confirmationCheckbox"></div>
                    <span>I understand that this action cannot be undone</span>
                </div>
                <div class="confirmation-hint">
                    You must confirm your understanding before proceeding with deletion.
                </div>
            </div>

            <div class="action-buttons">
                <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                    <i class="fas fa-trash"></i> Confirm Delete
                </button>
                <a href="/Genres/Index" class="btn btn-outline">
                    <i class="fas fa-arrow-left"></i> Back to Genres
                </a>
                <a href="/Genres/Edit?id=@Model.Genre.GenreId" class="btn btn-secondary">
                    <i class="fas fa-edit"></i> Edit Instead
                </a>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="message error-message">
                <div class="message-icon">❌</div>
                <div class="message-content">
                    <div class="message-title">Deletion Failed</div>
                    <div>@Model.ErrorMessage</div>
                </div>
            </div>
        }
    }
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/your-font-awesome-kit-code.js" crossorigin="anonymous"></script>
    <script>
        let isConfirmed = false;

        function toggleConfirmation() {
            isConfirmed = !isConfirmed;
            const checkbox = document.getElementById('confirmationCheckbox');
            const deleteButton = document.getElementById('deleteButton');
            
            if (isConfirmed) {
                checkbox.classList.add('checked');
                deleteButton.disabled = false;
            } else {
                checkbox.classList.remove('checked');
                deleteButton.disabled = true;
            }
        }

        document.getElementById('deleteForm').addEventListener('submit', function(e) {
            if (!isConfirmed) {
                e.preventDefault();
                alert('Please confirm that you understand this action cannot be undone.');
                return false;
            }
            
            // Additional confirmation for critical action
            const confirmed = confirm('Are you absolutely sure you want to permanently delete this genre? This action cannot be reversed.');
            if (!confirmed) {
                e.preventDefault();
            }
        });

        // Add keyboard shortcut prevention
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'Enter' || e.key === 'Return')) {
                if (document.getElementById('deleteForm').contains(document.activeElement)) {
                    e.preventDefault();
                }
            }
        });
    </script>
}