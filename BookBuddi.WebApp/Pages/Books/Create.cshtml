@page
@model BookBuddi.Pages.Books.CreateModel
@{
    ViewData["Title"] = "Create Book";
}

<link rel="stylesheet" href="~/css/books-create.css" />

<div class="page-wrapper" style="display: flex; gap: 20px; padding: 20px;">
    @await Html.PartialAsync("_AdminNavigation")

    <div class="page-container" style="flex: 1;">
        <div class="page-header">
            <div class="header-content">
                <h1>Add New Book</h1>
                <p>Expand your library collection by adding a new book with detailed information</p>
            </div>
        </div>

        <div class="main-content">
        <div class="form-container">
            <h2 class="form-title">Book Information</h2>
            <form method="post" id="bookForm" enctype="multipart/form-data">
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label class="form-label">
                            <i class="fas fa-heading"></i>Book Title
                        </label>
                        <div class="input-with-icon">
                            <i class="fas fa-book input-icon"></i>
                            <input type="text" asp-for="Book.BookTitle" class="form-control" required 
                                   placeholder="Enter the complete book title" maxlength="200" />
                        </div>
                        <div class="char-count"><span id="titleCount">0</span>/200 characters</div>
                        <div class="validation-message">Please enter a book title</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-barcode"></i>ISBN
                        </label>
                        <div class="input-with-icon">
                            <i class="fas fa-hashtag input-icon"></i>
                            <input type="text" asp-for="Book.ISBN" class="form-control" required 
                                   placeholder="e.g., 978-0123456789" pattern="^(?:\d{10}|\d{13}|(?:\d{3}-)?\d{10}|(?:\d{3}-)?\d{13})$" />
                        </div>
                        <div class="validation-message">Please enter a valid ISBN (10 or 13 digits)</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-building"></i>Publisher
                        </label>
                        <div class="input-with-icon">
                            <i class="fas fa-print input-icon"></i>
                            <input type="text" asp-for="Book.Publisher" class="form-control" 
                                   placeholder="Publisher name" maxlength="100" />
                        </div>
                        <div class="char-count"><span id="publisherCount">0</span>/100 characters</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label optional">
                            <i class="fas fa-calendar-alt"></i>Publication Date
                        </label>
                        <input type="date" asp-for="Book.PublicationDate" class="form-control" 
                               max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="form-group">
                        <label class="form-label optional">
                            <i class="fas fa-file-alt"></i>Page Count
                        </label>
                        <div class="input-with-icon">
                            <i class="fas fa-sort-numeric-up input-icon"></i>
                            <input type="number" asp-for="Book.PageCount" class="form-control" 
                                   placeholder="Number of pages" min="1" max="5000" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-copy"></i>Available Copies
                        </label>
                        <div class="input-with-icon">
                            <i class="fas fa-boxes input-icon"></i>
                            <input type="number" asp-for="Book.AvailableCopies" class="form-control" required
                                   placeholder="Number of copies" min="1" max="100" value="1" />
                        </div>
                        <div class="validation-message">Please enter the number of available copies</div>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label optional">
                            <i class="fas fa-image"></i>Book Cover Image
                        </label>
                        <div class="file-upload-container">
                            <input type="file" asp-for="CoverImageFile" class="form-control file-input"
                                   accept=".jpg,.jpeg,.png,.webp" id="coverImageInput" />
                            <div class="file-upload-info">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <span>Choose a cover image or drag and drop</span>
                                <small>Accepted: JPG, PNG, WEBP (Max 5MB)</small>
                            </div>
                        </div>
                        <div id="imagePreview" class="image-preview" style="display: none;">
                            <img id="previewImage" src="" alt="Cover preview" />
                            <button type="button" class="remove-image" id="removeImageBtn">
                                <i class="fas fa-times"></i> Remove
                            </button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-tags"></i>Category
                        </label>
                        <select asp-for="Book.CategoryId" class="form-control form-select" required>
                            <option value="">Select a category</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                        <div class="validation-message">Please select a category</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-theater-masks"></i>Genre
                        </label>
                        <select asp-for="Book.GenreId" class="form-control form-select" required>
                            <option value="">Select a genre</option>
                            @foreach (var genre in Model.Genres)
                            {
                                <option value="@genre.GenreId">@genre.GenreName</option>
                            }
                        </select>
                        <div class="validation-message">Please select a genre</div>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label optional">
                            <i class="fas fa-align-left"></i>Description
                        </label>
                        <textarea asp-for="Book.Description" class="form-control textarea" 
                                  placeholder="Enter a detailed description of the book..." 
                                  rows="4" maxlength="1000"></textarea>
                        <div class="char-count"><span id="descCount">0</span>/1000 characters</div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <i class="fas fa-plus-circle"></i> Create Book
                    </button>
                    <a href="/Books/Index" class="btn btn-outline">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                    <a href="/Admin/Index" class="btn btn-secondary">
                        <i class="fas fa-tachometer-alt"></i> Back to Dashboard
                    </a>
                </div>
            </form>

            <div class="message-container">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        <div class="alert-icon">⚠️</div>
                        <div>@Model.ErrorMessage</div>
                    </div>
                }
            </div>
        </div>

        <div class="sidebar">
            <h3 class="sidebar-title">Book Addition Tips</h3>
            <ul class="tips-list">
                <li>
                    <div class="tip-icon">📝</div>
                    <div>Enter the complete title as it appears on the book cover</div>
                </li>
                <li>
                    <div class="tip-icon">🔍</div>
                    <div>Verify ISBN accuracy - it helps with inventory management</div>
                </li>
                <li>
                    <div class="tip-icon">📚</div>
                    <div>Choose appropriate categories and genres for better organization</div>
                </li>
                <li>
                    <div class="tip-icon">📊</div>
                    <div>Set available copies based on your physical inventory</div>
                </li>
                <li>
                    <div class="tip-icon">✏️</div>
                    <div>Add a detailed description to help users find relevant books</div>
                </li>
            </ul>

            <div class="quick-stats">
                <div class="stat-item">
                    <span class="stat-label">Total Categories:</span>
                    <span class="stat-value">@Model.Categories.Count()</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Total Genres:</span>
                    <span class="stat-value">@Model.Genres.Count()</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Required Fields:</span>
                    <span class="stat-value">5</span>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

<div class="loading-overlay" id="loadingOverlay">
    <div class="loading-spinner"></div>
</div>

@section Scripts {
    <style>
        .file-upload-container {
            position: relative;
            border: 2px dashed #8B4049;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            background-color: #f9f9f9;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .file-upload-container:hover {
            border-color: #6d3139;
            background-color: #fff5f5;
        }

        .file-upload-container.drag-over {
            border-color: #d4a574;
            background-color: #fffbf5;
        }

        .file-input {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            opacity: 0;
            cursor: pointer;
        }

        .file-upload-info {
            pointer-events: none;
        }

        .file-upload-info i {
            font-size: 2rem;
            color: #8B4049;
            margin-bottom: 10px;
            display: block;
        }

        .file-upload-info span {
            display: block;
            font-weight: 500;
            color: #333;
            margin-bottom: 5px;
        }

        .file-upload-info small {
            display: block;
            color: #666;
            font-size: 0.85rem;
        }

        .image-preview {
            margin-top: 15px;
            position: relative;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 10px;
            background: white;
        }

        .image-preview img {
            max-width: 100%;
            max-height: 300px;
            border-radius: 4px;
            display: block;
            margin: 0 auto;
        }

        .remove-image {
            position: absolute;
            top: 15px;
            right: 15px;
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 4px;
            padding: 5px 10px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: background 0.3s ease;
        }

        .remove-image:hover {
            background: #c82333;
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Image upload preview
            const coverImageInput = document.getElementById('coverImageInput');
            const imagePreview = document.getElementById('imagePreview');
            const previewImage = document.getElementById('previewImage');
            const removeImageBtn = document.getElementById('removeImageBtn');
            const uploadContainer = coverImageInput?.closest('.file-upload-container');

            if (coverImageInput) {
                coverImageInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        // Validate file size (5MB)
                        if (file.size > 5 * 1024 * 1024) {
                            alert('File size must be less than 5MB');
                            coverImageInput.value = '';
                            return;
                        }

                        // Validate file type
                        const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
                        if (!allowedTypes.includes(file.type)) {
                            alert('Only JPG, PNG, and WEBP images are allowed');
                            coverImageInput.value = '';
                            return;
                        }

                        // Show preview
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            previewImage.src = e.target.result;
                            imagePreview.style.display = 'block';
                            if (uploadContainer) {
                                uploadContainer.style.display = 'none';
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                });

                // Remove image
                if (removeImageBtn) {
                    removeImageBtn.addEventListener('click', function() {
                        coverImageInput.value = '';
                        imagePreview.style.display = 'none';
                        if (uploadContainer) {
                            uploadContainer.style.display = 'block';
                        }
                    });
                }

                // Drag and drop
                if (uploadContainer) {
                    uploadContainer.addEventListener('dragover', function(e) {
                        e.preventDefault();
                        this.classList.add('drag-over');
                    });

                    uploadContainer.addEventListener('dragleave', function(e) {
                        e.preventDefault();
                        this.classList.remove('drag-over');
                    });

                    uploadContainer.addEventListener('drop', function(e) {
                        e.preventDefault();
                        this.classList.remove('drag-over');
                        const files = e.dataTransfer.files;
                        if (files.length > 0) {
                            coverImageInput.files = files;
                            coverImageInput.dispatchEvent(new Event('change'));
                        }
                    });
                }
            }

            // Character counters
            const titleInput = document.querySelector('input[asp-for="Book.BookTitle"]');
            const publisherInput = document.querySelector('input[asp-for="Book.Publisher"]');
            const descInput = document.querySelector('textarea[asp-for="Book.Description"]');
            
            const titleCount = document.getElementById('titleCount');
            const publisherCount = document.getElementById('publisherCount');
            const descCount = document.getElementById('descCount');
            
            // Initialize character counts
            [titleInput, publisherInput, descInput].forEach((input, index) => {
                if (input) {
                    const counter = [titleCount, publisherCount, descCount][index];
                    if (counter) {
                        counter.textContent = input.value.length;
                        input.addEventListener('input', function() {
                            counter.textContent = this.value.length;
                        });
                    }
                }
            });
            
            // Form submission handling
            const form = document.getElementById('bookForm');
            const submitBtn = document.getElementById('submitBtn');
            const loadingOverlay = document.getElementById('loadingOverlay');
            
            if (form) {
                form.addEventListener('submit', function(e) {
                    const requiredFields = form.querySelectorAll('[required]');
                    let isValid = true;
                    
                    requiredFields.forEach(field => {
                        if (!field.value.trim()) {
                            isValid = false;
                            field.style.borderColor = '#dc3545';
                            setTimeout(() => {
                                if (document.activeElement !== field) {
                                    field.style.borderColor = '';
                                }
                            }, 2000);
                        }
                    });
                    
                    if (!isValid) {
                        e.preventDefault();
                        // Scroll to first error
                        const firstError = form.querySelector('[required]:invalid');
                        if (firstError) {
                            firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            firstError.focus();
                        }
                    } else {
                        // Show loading state
                        if (loadingOverlay) {
                            loadingOverlay.style.display = 'flex';
                        }
                        if (submitBtn) {
                            submitBtn.disabled = true;
                            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating...';
                        }
                    }
                });
            }
            
            // ISBN formatting
            const isbnInput = document.querySelector('input[asp-for="Book.ISBN"]');
            if (isbnInput) {
                isbnInput.addEventListener('blur', function() {
                    let isbn = this.value.replace(/[-\s]/g, '');
                    if (isbn.length === 10 || isbn.length === 13) {
                        // Format with hyphens for better readability
                        if (isbn.length === 13) {
                            this.value = isbn.replace(/^(\d{3})(\d{1})(\d{4})(\d{4})(\d{1})$/, '$1-$2-$3-$4-$5');
                        } else if (isbn.length === 10) {
                            this.value = isbn.replace(/^(\d{1})(\d{4})(\d{4})(\d{1})$/, '$1-$2-$3-$4');
                        }
                    }
                });
            }
            
            // Real-time validation
            const inputs = form.querySelectorAll('.form-control, .form-select');
            inputs.forEach(input => {
                input.addEventListener('input', function() {
                    if (this.checkValidity()) {
                        this.style.borderColor = '';
                    }
                });
                
                input.addEventListener('blur', function() {
                    if (!this.checkValidity()) {
                        this.style.borderColor = '#dc3545';
                    }
                });
            });
        });
    </script>
}