@page
@model BookBuddi.Pages.Books.DeleteModel
@{
    ViewData["Title"] = "Delete Book";
}

<link rel="stylesheet" href="~/css/books-delete.css" />

<div class="page-wrapper">
    @await Html.PartialAsync("_AdminNavigation")

    <div class="content-wrapper">
        <div class="page-header">
            <div class="header-content">
                <h1><i class="fas fa-trash-alt"></i> Delete Book</h1>
                <p>Permanently remove a book from your library catalog</p>
            </div>
        </div>

        @if (Model.Book != null)
        {
            <div class="delete-container">
                @if (Model.HasTransactionHistory)
                {
                    <div class="warning-banner" style="background: #fff3cd; border-color: #ffc107;">
                        <i class="fas fa-info-circle" style="color: #856404;"></i>
                        <div>
                            <h3 style="color: #856404;">Book Will Be Archived</h3>
                            <p style="color: #856404;">This book has borrowing history and cannot be permanently deleted. It will be archived instead and hidden from the catalog.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="warning-banner">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div>
                            <h3>Warning: This action cannot be undone!</h3>
                            <p>This book has no borrowing history and will be permanently deleted from the library system.</p>
                        </div>
                    </div>
                }

                <div class="book-details-card">
                    <h2 class="card-title">Book Information</h2>
                    <dl class="details-list">
                        <div class="detail-row">
                            <dt><i class="fas fa-book"></i> Title</dt>
                            <dd>@Model.Book.BookTitle</dd>
                        </div>
                        <div class="detail-row">
                            <dt><i class="fas fa-barcode"></i> ISBN</dt>
                            <dd>@Model.Book.ISBN</dd>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Book.Publisher))
                        {
                            <div class="detail-row">
                                <dt><i class="fas fa-building"></i> Publisher</dt>
                                <dd>@Model.Book.Publisher</dd>
                            </div>
                        }
                        @if (Model.Book.PublicationDate.HasValue)
                        {
                            <div class="detail-row">
                                <dt><i class="fas fa-calendar-alt"></i> Publication Date</dt>
                                <dd>@Model.Book.PublicationDate.Value.ToString("MMMM dd, yyyy")</dd>
                            </div>
                        }
                        <div class="detail-row">
                            <dt><i class="fas fa-copy"></i> Available Copies</dt>
                            <dd>@Model.Book.AvailableCopies</dd>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Book.Description))
                        {
                            <div class="detail-row full-width">
                                <dt><i class="fas fa-align-left"></i> Description</dt>
                                <dd>@Model.Book.Description</dd>
                            </div>
                        }
                    </dl>
                </div>

                <form method="post" class="delete-form">
                    <input type="hidden" asp-for="Book.BookId" />

                    <div class="form-actions">
                        @if (Model.HasTransactionHistory)
                        {
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to archive this book? It will be hidden from the catalog.');" style="background: #ffc107; border-color: #ffc107; color: #000;">
                                <i class="fas fa-archive"></i> Confirm Archive
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you absolutely sure you want to permanently delete this book? This action cannot be undone.');">
                                <i class="fas fa-trash-alt"></i> Confirm Delete
                            </button>
                        }
                        <a href="/Books/Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                        <a href="/Admin/Index" class="btn btn-outline">
                            <i class="fas fa-tachometer-alt"></i> Back to Dashboard
                        </a>
                    </div>
                </form>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-error">
                        <i class="fas fa-exclamation-circle"></i>
                        <strong>Error:</strong> @Model.ErrorMessage
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i>
                <strong>Book not found.</strong>
                <p><a href="/Books/Index">Return to Books List</a></p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/your-font-awesome-kit-code.js" crossorigin="anonymous"></script>
}
