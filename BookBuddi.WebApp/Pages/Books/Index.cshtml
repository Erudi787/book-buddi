        margin-bottom: 15px;
    }

    .footer-description {
        color: #666;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .footer h3 {
        font-size: 1.1rem;
        margin-bottom: 15px;
        color: #333;
    }

    .footer a {
        display: block;
        color: #666;
        text-decoration: none;
        margin-bottom: 10px;
