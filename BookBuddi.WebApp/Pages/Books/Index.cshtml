<div class="top-nav">
    <div style="display: flex; align-items: center; gap: 10px;">
        <img src="/assets/logo.svg" alt="BookBuddi Logo" width="30" height="30" />
        <strong>Book Buddi</strong>
    </div>
    <div class="nav-right">
        @if (userRole == "Member")
        {
            <div class="member-actions">
                <a href="/Books/Index" class="active">Browse Books</a>
                <a href="/Borrowing/Index">My Borrowing</a>
                <a href="/BookRequests/Index">Request a Book</a>
                <a href="/Fines/Index">My Fines</a>
            </div>
        }
        @if (userRole == "Member")
        {
            <div class="notification-bell" onclick="toggleNotifications(event)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                @if (Model.UnreadNotificationCount > 0)
                {
                    <span class="notification-badge">@Model.UnreadNotificationCount</span>
                }
                <div class="notification-dropdown" id="notificationDropdown">
                    <div class="notification-header">
                        <h3>Your Notification</h3>
                        @if (Model.UnreadNotificationCount > 0)
                        {
                            <button class="mark-all-read-btn" onclick="markAllAsRead(event)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Mark All as read
                            </button>
                        }
                    </div>
                    
                    <div class="notification-tabs">
                        <button class="notification-tab active" data-tab="all" onclick="switchTab(event, 'all')">
                            View all <span class="tab-badge">@Model.RecentNotifications.Count()</span>
                        </button>
                        <button class="notification-tab" data-tab="duedate" onclick="switchTab(event, 'duedate')">
                            Due date <span class="tab-badge">@Model.RecentNotifications.Count(n => n.Type == BookBuddi.Resources.Constants.NotificationType.DueReminder)</span>
                        </button>
                        <button class="notification-tab" data-tab="request" onclick="switchTab(event, 'request')">
                            Request <span class="tab-badge">@Model.RecentNotifications.Count(n => n.Type == BookBuddi.Resources.Constants.NotificationType.RequestUpdate)</span>
                        </button>
                        <button class="notification-tab" data-tab="system" onclick="switchTab(event, 'system')">
                            System Alerts <span class="tab-badge">@Model.RecentNotifications.Count(n => n.Type == BookBuddi.Resources.Constants.NotificationType.OverdueAlert || n.Type == BookBuddi.Resources.Constants.NotificationType.FineIssued || n.Type == BookBuddi.Resources.Constants.NotificationType.General)</span>
                        </button>
                    </div>

                    <div class="notification-list" id="notificationList">
                        @if (Model.RecentNotifications != null && Model.RecentNotifications.Any())
                        {
                            @foreach (var notification in Model.RecentNotifications.OrderByDescending(n => n.DateCreated))
                            {
                                var notificationTypeClass = notification.Type == BookBuddi.Resources.Constants.NotificationType.DueReminder ? "duedate" :
                                                           notification.Type == BookBuddi.Resources.Constants.NotificationType.RequestUpdate ? "request" : "system";
                                
                                <div class="notification-card @(!notification.IsRead ? "unread" : "")" 
                                     data-notification-id="@notification.NotificationId"
                                     data-notification-type="@notificationTypeClass"
                                     onclick="openNotificationModal(@notification.NotificationId, '@notification.Title.Replace("'", "\\'")' , '@notification.Message.Replace("'", "\\'")' , '@notification.DateCreated.ToString("MMMM dd, yyyy")', '@notification.DateCreated.ToString("h:mm tt")', @notification.IsRead.ToString().ToLower())">
                                    <div class="notification-indicator @(!notification.IsRead ? "unread" : "read")"></div>
                                    <div class="notification-content">
                                        <div class="notification-title">@notification.Title</div>
                                        <div class="notification-message">@notification.Message</div>
                                        <div class="notification-meta">
                                            <span class="notification-time">@notification.DateCreated.ToString("MMMM dd, yyyy") @notification.DateCreated.ToString("h:mm tt")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="notification-empty">
                                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                </svg>
                                <p>No new notifications</p>
                            </div>
                        }
                    </div>
                    <div class="notification-footer">
                        <a href="/Notifications/Index" class="btn-view-all-notifications">View All Notifications</a>
                    </div>
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(userName))
        {
            <div class="user-account">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span>@userName</span>
            </div>
        }
        @if (userRole == "Member")
        {
            <a href="/Account/Logout" class="btn-my-books">Logout</a>
        }
        else if (userRole == "Admin")
        {
            <a href="/Admin/Index" class="btn-my-books">Admin Panel</a>
        }
    </div>
</div>

<div class="catalog-header">
