@page
@model BookBuddi.Pages.Categories.EditModel
@{
    ViewData["Title"] = "Edit Category";
    var isAdmin = HttpContext.Session.GetString("UserRole") == "Admin";
}

<h1>Edit Category</h1>

@if (!isAdmin)
{
    <p style="color: red;">Admin access required.</p>
    <p><a href="/Account/Login">Login as Admin</a></p>
}
else
{
    <form method="post" style="max-width: 600px;">
        <input type="hidden" asp-for="Category.CategoryId" />
        <input type="hidden" asp-for="Category.CreatedBy" />
        <input type="hidden" asp-for="Category.CreatedTime" />

        <div style="margin-bottom: 15px;">
            <label style="font-weight: bold;">Category Name: *</label><br/>
            <input type="text" asp-for="Category.CategoryName" required style="width: 100%; padding: 8px;" maxlength="100" />
        </div>
        <div style="margin-bottom: 15px;">
            <label style="font-weight: bold;">Description:</label><br/>
            <textarea asp-for="Category.Description" rows="4" style="width: 100%; padding: 8px;" maxlength="500"></textarea>
        </div>
        <div style="margin-bottom: 15px;">
            <p style="color: #666; font-size: 14px;">
                Created by: <strong>@Model.Category.CreatedBy</strong> on @Model.Category.CreatedTime.ToString("MMM dd, yyyy hh:mm tt")
            </p>
        </div>
        <div>
            <button type="submit" style="padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer;">Update Category</button>
            <a href="/Categories/Index" style="margin-left: 10px; padding: 10px 20px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 5px;">Cancel</a>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div style="margin-top: 20px; padding: 10px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 5px;">
            @Model.ErrorMessage
        </div>
    }
}
