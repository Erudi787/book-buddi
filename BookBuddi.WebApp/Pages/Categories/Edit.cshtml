@page
@model BookBuddi.Pages.Categories.EditModel
@{
    ViewData["Title"] = "Edit Category";
    var isAdmin = HttpContext.Session.GetString("UserRole") == "Admin";
}

<link rel="stylesheet" href="~/css/categories-edit.css" />

<div class="edit-category-container">
    <div class="page-header">
        <h1>Edit Category</h1>
        <p>Update category information and description</p>
    </div>

    @if (!isAdmin)
    {
        <div class="access-denied">
            <div class="material-icons access-denied-icon">admin_panel_settings</div>
            <h2>Admin Access Required</h2>
            <p>You need administrator privileges to edit categories.</p>
            <a href="/Account/Login" class="btn-primary">
                <span class="material-icons">login</span>
                Login as Admin
            </a>
        </div>
    }
    else
    {
        <form method="post" class="category-form">
            <input type="hidden" asp-for="Category.CategoryId" />
            <input type="hidden" asp-for="Category.CreatedBy" />
            <input type="hidden" asp-for="Category.CreatedTime" />

            <div class="form-group">
                <label class="form-label required">Category Name</label>
                <input type="text" asp-for="Category.CategoryName" class="form-input" required 
                       placeholder="Enter category name" maxlength="100" />
                <div class="char-counter" id="nameCounter">
                    <span id="nameLength">0</span>/100 characters
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Description</label>
                <textarea asp-for="Category.Description" class="form-textarea" 
                          placeholder="Enter category description (optional)" 
                          maxlength="500"></textarea>
                <div class="char-counter" id="descCounter">
                    <span id="descLength">0</span>/500 characters
                </div>
            </div>

            <div class="meta-info">
                <p>
                    <span class="material-icons">person</span>
                    Created by: <strong>@Model.Category.CreatedBy</strong>
                </p>
                <p>
                    <span class="material-icons">calendar_today</span>
                    Created on: <strong>@Model.Category.CreatedTime.ToString("MMM dd, yyyy 'at' hh:mm tt")</strong>
                </p>
            </div>

            <div class="form-actions">
                <a href="/Categories/Index" class="btn btn-outline">
                    <span class="material-icons">arrow_back</span>
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    <span class="material-icons">save</span>
                    Update Category
                </button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error-message">
                @Model.ErrorMessage
            </div>
        }
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Character counters
        const nameInput = document.querySelector('input[name="Category.CategoryName"]');
        const descTextarea = document.querySelector('textarea[name="Category.Description"]');
        const nameCounter = document.getElementById('nameCounter');
        const descCounter = document.getElementById('descCounter');
        const nameLength = document.getElementById('nameLength');
        const descLength = document.getElementById('descLength');

        // Initialize counters with current values
        if (nameInput && nameLength) {
            nameLength.textContent = nameInput.value.length;
            updateCounterStyle(nameCounter, nameInput.value.length, 100);
        }

        if (descTextarea && descLength) {
            descLength.textContent = descTextarea.value.length;
            updateCounterStyle(descCounter, descTextarea.value.length, 500);
        }

        // Add event listeners for real-time updates
        if (nameInput) {
            nameInput.addEventListener('input', function() {
                nameLength.textContent = this.value.length;
                updateCounterStyle(nameCounter, this.value.length, 100);
            });
        }

        if (descTextarea) {
            descTextarea.addEventListener('input', function() {
                descLength.textContent = this.value.length;
                updateCounterStyle(descCounter, this.value.length, 500);
            });
        }

        function updateCounterStyle(counter, current, max) {
            counter.classList.remove('warning', 'danger');
            if (current > max * 0.9) {
                counter.classList.add('danger');
            } else if (current > max * 0.75) {
                counter.classList.add('warning');
            }
        }

        // Form validation enhancement
        const form = document.querySelector('.category-form');
        if (form) {
            form.addEventListener('submit', function(e) {
                const nameInput = this.querySelector('input[name="Category.CategoryName"]');
                if (!nameInput.value.trim()) {
                    e.preventDefault();
                    nameInput.focus();
                    nameInput.style.borderColor = '#dc2626';
                }
            });

            // Real-time validation feedback
            const inputs = form.querySelectorAll('input, textarea');
            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    validateField(this);
                });

                input.addEventListener('input', function() {
                    if (this.classList.contains('invalid')) {
                        validateField(this);
                    }
                });
            });

            function validateField(field) {
                if (field.required && !field.value.trim()) {
                    field.classList.add('invalid');
                    field.style.borderColor = '#dc2626';
                } else {
                    field.classList.remove('invalid');
                    field.style.borderColor = '';
                }
            }
        }
    });
</script>