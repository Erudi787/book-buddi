@page
@model BookBuddi.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
    var isAdmin = HttpContext.Session.GetString("UserRole") == "Admin";
}

<link rel="stylesheet" href="~/css/categories-delete.css" />

<div class="page-wrapper" style="display: flex; gap: 20px; padding: 20px;">
    @await Html.PartialAsync("_AdminNavigation")

    <div class="delete-category-container" style="flex: 1;">
    <div class="page-header">
        <h1>Delete Category</h1>
        <p>Remove category from the system</p>
    </div>

    @if (!isAdmin)
    {
        <div class="access-denied">
            <div class="material-icons access-denied-icon">admin_panel_settings</div>
            <h2>Admin Access Required</h2>
            <p>You need administrator privileges to delete categories.</p>
            <a href="/Account/Login" class="btn btn-danger">
                <span class="material-icons">login</span>
                Login as Admin
            </a>
        </div>
    }
    else
    {
        <div class="warning-card">
            <div class="material-icons warning-icon">warning</div>
            <h3 class="warning-title">Confirm Deletion</h3>
            <p class="warning-message">
                This action cannot be undone. The category will be permanently removed from the system.
            </p>
        </div>

        <div class="details-card">
            <div class="details-header">
                <span class="material-icons details-header-icon">category</span>
                <h3>Category Details</h3>
            </div>
            
            <div class="details-grid">
                <div class="detail-item">
                    <span class="detail-label">Category ID</span>
                    <span class="detail-value">@Model.Category.CategoryId</span>
                </div>
                
                <div class="detail-item">
                    <span class="detail-label">Category Name</span>
                    <span class="detail-value category-name">@Model.Category.CategoryName</span>
                </div>
                
                <div class="detail-item">
                    <span class="detail-label">Description</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(Model.Category.Description) ? "No description provided" : Model.Category.Description)</span>
                </div>
                
                <div class="detail-item">
                    <span class="detail-label">Created By</span>
                    <span class="detail-value">@Model.Category.CreatedBy</span>
                </div>
                
                <div class="detail-item">
                    <span class="detail-label">Created Date</span>
                    <span class="detail-value">@Model.Category.CreatedTime.ToString("MMM dd, yyyy 'at' hh:mm tt")</span>
                </div>
            </div>
        </div>

        <form method="post" class="delete-form">
            <input type="hidden" name="id" value="@Model.Category.CategoryId" />
            
            <div class="action-buttons">
                <a href="/Categories/Index" class="btn btn-outline">
                    <span class="material-icons">arrow_back</span>
                    Cancel
                </a>
                <button type="submit" class="btn btn-danger" onclick="return confirmDeletion()">
                    <span class="material-icons">delete_forever</span>
                    Confirm Delete
                </button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error-message">
                @Model.ErrorMessage
            </div>
        }
    }
    </div>
</div>

<script>
    function confirmDeletion() {
        const categoryName = '@Model.Category.CategoryName';
        return confirm(`Are you absolutely sure you want to delete the category "${categoryName}"? This action cannot be undone.`);
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Add keyboard event listeners for better UX
        const cancelBtn = document.querySelector('.btn-outline');
        const deleteBtn = document.querySelector('.btn-danger');
        
        if (cancelBtn) {
            cancelBtn.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    this.click();
                }
            });
        }
        
        if (deleteBtn) {
            deleteBtn.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    if (confirmDeletion()) {
                        this.closest('form').submit();
                    }
                }
            });
        }
        
        // Escape key to cancel
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                window.location.href = '/Categories/Index';
            }
        });
    });
</script>