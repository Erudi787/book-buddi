@page
@model BookBuddi.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
    var isAdmin = HttpContext.Session.GetString("UserRole") == "Admin";
}

<h1>Delete Category</h1>

@if (!isAdmin)
{
    <p style="color: red;">Admin access required.</p>
    <p><a href="/Admin/Login">Login as Admin</a></p>
}
else
{
    <div style="max-width: 600px;">
        <div style="padding: 20px; background-color: #fff3cd; border: 1px solid #ffeeba; border-radius: 5px; margin-bottom: 20px;">
            <h3 style="color: #856404;">Are you sure you want to delete this category?</h3>
            <p style="color: #856404;">This action cannot be undone.</p>
        </div>

        <div style="background-color: #f8f9fa; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
            <p><strong>Category ID:</strong> @Model.Category.CategoryId</p>
            <p><strong>Category Name:</strong> @Model.Category.CategoryName</p>
            <p><strong>Description:</strong> @(Model.Category.Description ?? "-")</p>
            <p><strong>Created By:</strong> @Model.Category.CreatedBy</p>
            <p><strong>Created Date:</strong> @Model.Category.CreatedTime.ToString("MMM dd, yyyy")</p>
        </div>

        <form method="post">
            <input type="hidden" name="id" value="@Model.Category.CategoryId" />
            <button type="submit" style="padding: 10px 20px; background-color: #dc3545; color: white; border: none; border-radius: 5px; cursor: pointer;">Confirm Delete</button>
            <a href="/Categories/Index" style="margin-left: 10px; padding: 10px 20px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 5px;">Cancel</a>
        </form>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div style="margin-top: 20px; padding: 10px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 5px;">
                @Model.ErrorMessage
            </div>
        }
    </div>
}
