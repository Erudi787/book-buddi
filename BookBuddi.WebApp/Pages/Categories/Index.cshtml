@page
@model BookBuddi.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories Management";
    var isAdmin = HttpContext.Session.GetString("UserRole") == "Admin";
}

<h1>Categories Management</h1>

@if (!isAdmin)
{
    <p style="color: red;">Admin access required to manage categories.</p>
    <p><a href="/Account/Login">Login as Admin</a></p>
}
else
{
    <div style="margin-bottom: 20px;">
        <a href="/Categories/Create" style="padding: 10px 15px; background-color: #007bff; color: white; text-decoration: none; border-radius: 5px;">Add New Category</a>
    </div>

    <div style="margin-bottom: 20px;">
        <form method="get">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search categories..." style="padding: 8px; width: 300px;" />
            <button type="submit" style="padding: 8px 15px;">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a href="/Categories/Index">Clear</a>
            }
        </form>
    </div>

    @if (Model.Categories.Any())
    {
        <table border="1" style="width: 100%; border-collapse: collapse;">
            <thead style="background-color: #f8f9fa;">
                <tr>
                    <th style="padding: 10px;">ID</th>
                    <th style="padding: 10px;">Category Name</th>
                    <th style="padding: 10px;">Description</th>
                    <th style="padding: 10px;">Created By</th>
                    <th style="padding: 10px;">Created Date</th>
                    <th style="padding: 10px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td style="padding: 10px;">@category.CategoryId</td>
                        <td style="padding: 10px;"><strong>@category.CategoryName</strong></td>
                        <td style="padding: 10px;">@(category.Description ?? "-")</td>
                        <td style="padding: 10px;">@category.CreatedBy</td>
                        <td style="padding: 10px;">@category.CreatedTime.ToString("MMM dd, yyyy")</td>
                        <td style="padding: 10px;">
                            <a href="/Categories/Edit?id=@category.CategoryId">Edit</a> |
                            <a href="/Categories/Delete?id=@category.CategoryId" style="color: red;">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No categories found.</p>
    }
}

<p style="margin-top: 20px;"><a href="/">Back to Home</a></p>
