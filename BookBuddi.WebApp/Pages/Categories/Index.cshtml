@page
@model BookBuddi.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories Management";
    var isAdmin = HttpContext.Session.GetString("UserRole") == "Admin";
}

<link rel="stylesheet" href="~/css/categories-index.css" />

<div class="categories-container">
    <div class="page-header">
        <h1>Categories Management</h1>
        <p>Organize and manage book categories</p>
    </div>

    @if (!isAdmin)
    {
        <div class="access-denied">
            <div class="material-icons access-denied-icon">admin_panel_settings</div>
            <h2>Admin Access Required</h2>
            <p>You need administrator privileges to manage categories.</p>
            <a href="/Account/Login" class="btn-primary">
                <span class="material-icons">login</span>
                Login as Admin
            </a>
        </div>
    }
    else
    {
        <div class="action-bar">
            <a href="/Categories/Create" class="btn-primary">
                <span class="material-icons">add</span>
                Add New Category
            </a>
            
            <form method="get" class="search-form">
                <input type="text" name="searchTerm" class="search-input" placeholder="Search categories..." value="@Model.SearchTerm" />
                <button type="submit" class="btn-secondary">
                    <span class="material-icons">search</span>
                    Search
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a href="/Categories/Index" class="btn-link">Clear</a>
                }
            </form>
        </div>

        @if (Model.Categories.Any())
        {
            <div class="table-container">
                <table class="categories-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Created By</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td data-label="ID">@category.CategoryId</td>
                                <td data-label="Category Name">
                                    <div class="category-name">@category.CategoryName</div>
                                </td>
                                <td data-label="Description">
                                    <div class="category-description">@(category.Description ?? "No description")</div>
                                </td>
                                <td data-label="Created By">@category.CreatedBy</td>
                                <td data-label="Created Date">@category.CreatedTime.ToString("MMM dd, yyyy")</td>
                                <td data-label="Actions">
                                    <div class="action-buttons">
                                        <a href="/Categories/Edit?id=@category.CategoryId" class="action-btn" data-tooltip="Edit">
                                            <span class="material-icons icon">edit</span>
                                        </a>
                                        <a href="/Categories/Delete?id=@category.CategoryId" class="action-btn danger" data-tooltip="Delete">
                                            <span class="material-icons icon">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="material-icons empty-state-icon">category</div>
                <h3>No Categories Found</h3>
                <p>@(!string.IsNullOrWhiteSpace(Model.SearchTerm) ? "No categories match your search criteria." : "Get started by creating your first category.")</p>
                @if (string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a href="/Categories/Create" class="btn-primary">
                        <span class="material-icons">add</span>
                        Create First Category
                    </a>
                }
                else
                {
                    <a href="/Categories/Index" class="btn-primary">
                        <span class="material-icons">clear_all</span>
                        Clear Search
                    </a>
                }
            </div>
        }
    }

    <div class="footer">
        <a href="/" class="footer-link">
            <span class="material-icons">arrow_back</span>
            Back to Home
        </a>
    </div>
</div>